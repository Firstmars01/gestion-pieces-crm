{% extends 'base.html.twig' %}
{% block title %}Synergy CRM{% endblock %}

{% block body %}
    <div class="login-split-container">

        <div class="login-image-side">
        </div>

        <div class="login-form-side">

            <div class="login-center-block">

                <div class="login-logo-container">
                    <img src="{{ asset('images/logo.png') }}" alt="Synergy CRM" class="login-main-logo">
                </div>

                <div class="login-card">
                    <form method="post">
                        {% if error %}
                            <div class="alert alert-danger mb-3">{{ error.messageKey|trans(error.messageData, 'security') }}</div>
                        {% endif %}

                        {% if app.user %}
                            <div class="mb-3">
                                Vous êtes connecter avec {{ app.user.userIdentifier }}, <a href="{{ logout_path() }}">Déconnexion</a>
                            </div>
                        {% endif %}

                        <div class="mb-3">
                            <label for="username" class="form-label-custom">Email</label>
                            <input type="email" value="{{ last_username }}" name="_username" id="username" class="form-control-custom" placeholder="....@crm.com" autocomplete="email" required autofocus>
                        </div>

                        <div class="mb-3">
                            <label for="password" class="form-label-custom">Mot de passe</label>
                            <input type="password" name="_password" id="password" class="form-control-custom" placeholder="Your password" autocomplete="current-password" required>
                        </div>

                        <input type="hidden" name="_csrf_token" data-controller="csrf-protection" value="{{ csrf_token('authenticate') }}">

                        <button class="btn-login-submit" type="submit">
                            Connexion
                        </button>

                    </form>
                </div>

            </div> </div>
    </div>
{% endblock %}
