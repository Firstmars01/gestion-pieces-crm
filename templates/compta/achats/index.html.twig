{% extends './base.html.twig' %}

{% block title %}Comptabilité - Factures Fournisseurs{% endblock %}

{% block body %}
    <div class="container-fluid py-4">
        <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-start gap-3 mb-4">
            <div>
                <h1 class="h3 mb-1">Achats Fournisseurs</h1>
                <p class="text-muted mb-0">Retrouvez ici toutes les commandes d'achat réceptionnées prêtes pour l'archivage.</p>
            </div>

            <div class="d-flex flex-column flex-sm-row gap-2">
                <form method="get" class="mb-0">
                    <div class="input-group">
                        <input type="text" name="q" class="form-control" placeholder="Rechercher..." value="{{ app.request.query.get('q') }}">
                        {% if app.request.query.get('q') %}
                            <a href="{{ path('compta_achats_index') }}" class="btn btn-outline-secondary d-flex align-items-center justify-content-center" title="Effacer la recherche">
                                <i class="bi bi-x-lg"></i>
                            </a>
                        {% endif %}
                        <button class="btn btn-primary d-flex align-items-center justify-content-center" type="submit">
                            <i class="bi bi-search"></i>
                        </button>
                    </div>
                </form>

                    <form method="get" action="{{ path('compta_achats_csv') }}" class="d-flex align-items-center gap-2 mb-0 ms-2 border-start ps-2">

                        {% set moisNoms = {'01':'Janvier', '02':'Février', '03':'Mars', '04':'Avril', '05':'Mai', '06':'Juin', '07':'Juillet', '08':'Août', '09':'Septembre', '10':'Octobre', '11':'Novembre', '12':'Décembre'} %}
                        {% set lastMonth = "now"|date_modify("-1 month")|date("m") %}
                        {% set lastYear = "now"|date_modify("-1 month")|date("Y") %}

                        {# NOUVEAU : On affiche toujours les 12 mois #}
                        <select name="mois" class="form-select form-select-sm w-auto select-mois" required>
                            {% for code, nom in moisNoms %}
                                <option value="{{ code }}" {% if code == lastMonth %}selected{% endif %}>{{ nom }}</option>
                            {% endfor %}
                        </select>

                        <select name="annee" class="form-select form-select-sm w-auto select-annee" required>
                            {% for a in anneesDispo %}
                                <option value="{{ a }}" {% if a == lastYear %}selected{% endif %}>{{ a }}</option>
                            {% endfor %}
                        </select>

                        <button type="submit" class="btn btn-sm btn-success d-flex align-items-center">
                            <i class="bi bi-filetype-csv me-1"></i> CSV
                        </button>
                    </form>
            </div>
        </div>

        <div class="card shadow-sm border-0 overflow-hidden">
            <div class="card-header bg-white py-3 border-bottom-0">
                <h6 class="mb-0 fw-bold"><i class="bi bi-receipt me-2"></i>Registre des Factures d'Achat</h6>
            </div>
            <div class="table-responsive">
                <table class="table align-middle mb-0 table-hover table-sortable">
                    <thead class="table-light">
                    <tr>
                        <th scope="col">{{ knp_pagination_sortable(achats, 'N° Commande', 'c.id') }}</th>
                        <th scope="col">{{ knp_pagination_sortable(achats, 'Date Réception', 'c.dateReelle') }}</th>
                        <th scope="col">{{ knp_pagination_sortable(achats, 'Fournisseur', 'fournisseur.raisonSociale') }}</th>
                        <th scope="col" class="text-center">Nb. Lignes</th>
                        <th scope="col" class="text-end">Montant HT</th>
                        <th scope="col" class="text-end"></th>
                    </tr>
                    </thead>
                    <tbody>
                    {% for achat in achats %}
                        <tr>
                            <td class="fw-bold text-dark">{{ achat.id }}</td>
                            <td>{{ achat.dateReelle ? achat.dateReelle|date('d/m/Y') : '-' }}</td>
                            <td>
                                {{ achat.fournisseur.raisonSociale }}
                            </td>
                            <td class="text-center">
                                <span class="badge bg-light text-dark border">{{ achat.lignes|length }}</span>
                            </td>
                            <td class="text-end fw-bold text-primary">
                                {{ achat.getTotal()|number_format(2, ',', ' ') }} €
                            </td>
                            <td class="text-end">
                                <div class="d-flex justify-content-end gap-2 action-buttons">
                                    <a href="{{ path('compta_achat_pdf', {id: achat.id}) }}" class="btn btn-sm btn-outline-danger" title="Télécharger le PDF d'achat">
                                        <i class="bi bi-file-earmark-pdf-fill me-1"></i> PDF
                                    </a>
                                </div>
                            </td>
                        </tr>
                    {% else %}
                        <tr>
                            <td colspan="6" class="text-center text-muted py-5">
                                <i class="bi bi-inbox fs-2 d-block mb-2 text-muted"></i>
                                Aucune facture d'achat disponible pour le moment.
                            </td>
                        </tr>
                    {% endfor %}
                    </tbody>
                </table>
            </div>
        </div>

        <div class="pagination-container pagination-pill mt-3">
            {{ knp_pagination_render(achats) }}
        </div>
    </div>
{% endblock %}
