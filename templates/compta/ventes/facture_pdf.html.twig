<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <title>Facture {{ commande.numero }}</title>

    {# Assure-toi que ton dossier s'appelle bien 'styles' ou 'css' selon ton arborescence #}
    <link rel="stylesheet" href="{{ public_dir }}/styles/pdf.css">
</head>
<body>

<div class="header">
    <div class="company-info">
        <div class="company-name">SYNERGY CRM</div>
        <p class="company-details">
            123 Boulevard de l'Industrie<br>
            75000 Paris, France<br>
            Tél : 01 23 45 67 89<br>
            Email : compta@synergy.fr
        </p>
    </div>
    <div class="client-info">
        <h3 class="client-title">Facturé à :</h3>
        <p>
            <strong>{{ commande.client.raisonSociale ?: commande.client.nomComplet }}</strong><br>
            {{ commande.client.email }}<br>
            {{ commande.client.telephone }}
        </p>
    </div>
    <div class="clear"></div>
</div>

<h1 class="invoice-title">Facture N° {{ commande.numero }}</h1>
<div class="invoice-meta">
    Date d'expédition : {{ commande.dateFacture ? commande.dateFacture|date('d/m/Y') : 'Non renseignée' }}
</div>

<table>
    <thead>
    <tr>
        <th>Référence</th>
        <th>Désignation</th>
        <th class="text-center">Qté</th>
        <th class="text-right">Prix Unitaire</th>
        <th class="text-right">Total Ligne</th>
    </tr>
    </thead>
    <tbody>
    {% for ligne in commande.commandeLignes %}
        <tr>
            <td>{{ ligne.piece.reference }}</td>
            <td>{{ ligne.piece.libelle }}</td>
            <td class="text-center">{{ ligne.quantite }}</td>
            <td class="text-right">{{ ligne.prixUnitaire|number_format(2, ',', ' ') }} €</td>
            <td class="text-right">{{ (ligne.prixUnitaire * ligne.quantite)|number_format(2, ',', ' ') }} €</td>
        </tr>
    {% endfor %}
    </tbody>
    <tfoot>
    <tr class="total-row">
        <td colspan="4" class="total-label">TOTAL HT :</td>
        <td class="text-right">{{ commande.getTotal()|number_format(2, ',', ' ') }} €</td>
    </tr>
    </tfoot>
</table>

<div class="footer-notes">
    <p>Merci pour votre confiance.</p>
    <p>TVA non applicable, art. 293 B du CGI.</p>
</div>

</body>
</html>
