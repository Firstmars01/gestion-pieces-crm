{% extends './base.html.twig' %}

{% block title %}Détail Devis #{{ devis.id }}{% endblock %}

{% block body %}
    <div class="container-fluid py-4 max-w-1000px">

        <div class="mb-4">
            <a href="{{ path('commercial_devis_index') }}" class="btn btn-sm btn-outline-secondary mb-2">
                <i class="bi bi-arrow-left"></i> Retour aux devis
            </a>
        </div>

        {# Carte principale (En-tête du devis) #}
        <div class="card shadow-sm border-0 mb-4">
            <div class="card-body d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3">
                <div>
                    <h5 class="mb-1 fw-bold text-dark text-uppercase">
                        {{ devis.client.raisonSociale ? devis.client.raisonSociale : devis.client.nomComplet }}
                    </h5>
                    <div class="text-muted small">
                        Devis #{{ devis.id }} • Créé le {{ devis.dateDevis|date('d/m/Y') }}
                        {% if devis.dateLimite %} • Valide jusqu'au {{ devis.dateLimite|date('d/m/Y') }}{% endif %}
                    </div>
                </div>

                <div class="text-md-end">
                    <div class="fs-4 fw-bold text-primary">{{ devis.getTotal()|number_format(2, ',', ' ') }} €</div>
                    <div class="text-muted small">Montant total HT</div>
                </div>
            </div>
        </div>

        {# Tableau des lignes du devis #}
        <div class="card shadow-sm border-0 overflow-hidden">
            <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center border-bottom-0">
                <h6 class="mb-0 fw-bold"><i class="bi bi-list-check me-2"></i>Contenu du devis</h6>

                {# Bouton pour ajouter des pièces #}
                <button type="button" onclick="openModalAjax('Ajouter une pièce', '{{ path('commercial_devis_ligne_new', {id: devis.id}) }}')" class="btn btn-sm btn-primary">
                    <i class="bi bi-plus-circle me-1"></i> Ajouter une pièce
                </button>
            </div>

            <div class="table-responsive">
                <table class="table align-middle mb-0">
                    <thead class="table-light">
                    <tr>
                        <th>Référence</th>
                        <th>Pièce</th>
                        <th class="text-center">Quantité</th>
                        <th class="text-end">Prix U.</th>
                        <th class="text-end">Total Ligne</th>
                        <th class="text-end"></th>
                    </tr>
                    </thead>
                    <tbody>
                    {% for ligne in devis.devisLignes %}
                        <tr>
                            <td class="fw-semibold text-muted">{{ ligne.piece.reference }}</td>
                            <td class="fw-medium text-dark">{{ ligne.piece.libelle }}</td>
                            <td class="text-center">
                                <span class="badge bg-secondary bg-opacity-10 text-dark border px-2 py-1">{{ ligne.quantite }}</span>
                            </td>
                            <td class="text-end text-muted">{{ ligne.prix|number_format(2, ',', ' ') }} €</td>
                            <td class="text-end fw-bold text-dark">
                                {{ (ligne.prix * ligne.quantite)|number_format(2, ',', ' ') }} €
                            </td>
                            <td class="text-end">
                                {# Boutons cachés gérés par la classe action-buttons #}
                                <div class="d-flex justify-content-end gap-2 action-buttons">

                                    <button type="button"
                                            onclick="openModalAjax('Modifier la ligne', '{{ path('commercial_devis_ligne_edit', {id: ligne.id}) }}')"
                                            class="btn btn-sm btn-outline-primary" title="Modifier">
                                        <i class="bi bi-pencil-square"></i>
                                    </button>

                                    <form method="post" action="{{ path('commercial_devis_ligne_delete', {id: ligne.id}) }}" onsubmit="return confirm('Êtes-vous sûr de vouloir retirer cette pièce du devis ?');" class="mb-0">
                                        <input type="hidden" name="_token" value="{{ csrf_token('delete_ligne_' ~ ligne.id) }}">
                                        <button class="btn btn-sm btn-outline-danger" type="submit" title="Supprimer">
                                            <i class="bi bi-trash"></i>
                                        </button>
                                    </form>

                                </div>
                            </td>
                        </tr>
                    {% else %}
                        <tr>
                            <td colspan="6" class="text-center text-muted py-5">
                                <i class="bi bi-inbox fs-1 d-block mb-2 text-secondary opacity-50"></i>
                                Aucune pièce ajoutée. Cliquez sur "Ajouter une pièce" en haut à droite.
                            </td>
                        </tr>
                    {% endfor %}
                    </tbody>
                </table>
            </div>
        </div>

    </div>
{% endblock %}
