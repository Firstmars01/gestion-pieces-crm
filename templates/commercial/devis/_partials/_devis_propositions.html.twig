<div class="card shadow-sm border-0 mb-4">
    <div class="card-body d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3">
        <div>
            <h5 class="mb-1 fw-bold text-dark text-uppercase">
                {{ devis.nom is empty ? 'Devis #' ~ devis.id : devis.nom }}
            </h5>
            <div class="text-muted small">
                {{ devis.client.raisonSociale ? devis.client.raisonSociale : devis.client.nomComplet }}
            </div>
            <div class="text-muted small">
                Devis #{{ devis.id }} • Créé le {{ devis.dateDevis|date('d/m/Y') }}
                {% if devis.dateLimite %} • <span class="{{ date() > devis.dateLimite ? 'text-danger fw-bold' : '' }}">Valide jusqu'au {{ devis.dateLimite|date('d/m/Y') }}</span>{% endif %}
            </div>
        </div>
        <div class="text-md-end">
            <div class="fs-4 fw-bold text-primary">{{ devis.getTotal()|number_format(2, ',', ' ') }} €</div>
            <div class="text-muted small">Montant total HT proposé</div>
        </div>
    </div>
</div>

<div class="card shadow-sm border-0 overflow-hidden mb-5">
    <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center border-bottom-0">
        <h6 class="mb-0 fw-bold"><i class="bi bi-card-list me-2"></i>Contenu du Devis (Propositions)</h6>
        <button type="button" onclick="openModalAjax('Ajouter une pièce au devis', '{{ path('commercial_devis_ligne_new', {id: devis.id}) }}')" class="btn btn-sm btn-outline-primary" {{ isExpired ? 'disabled' : '' }}>
            <i class="bi bi-plus-circle me-1"></i> Pièce au devis
        </button>
    </div>

    <div class="table-responsive">
        <table class="table align-middle mb-0">
            <thead class="table-light">
            <tr>
                <th>Pièce</th>
                <th class="text-center">Quantité</th>
                <th class="text-end">Prix U.</th>
                <th class="text-end">Total Ligne</th>
                <th class="text-end"></th>
            </tr>
            </thead>
            <tbody>
            {% for ligne in devis.devisLignes %}
                {% set countCommandees = 0 %}
                {% for cmd in devis.commandes %}
                    {% for cl in cmd.commandeLignes %}
                        {% if cl.piece.id == ligne.piece.id and cl.quantite == ligne.quantite %}
                            {% set countCommandees = countCommandees + 1 %}
                        {% endif %}
                    {% endfor %}
                {% endfor %}

                {% set occurrenceIndex = 0 %}
                {% for dl in devis.devisLignes %}
                    {% if dl.piece.id == ligne.piece.id and dl.quantite == ligne.quantite %}
                        {% if loop.index0 <= loop.parent.loop.index0 %}
                            {% set occurrenceIndex = occurrenceIndex + 1 %}
                        {% endif %}
                    {% endif %}
                {% endfor %}

                {% set isCommandee = occurrenceIndex <= countCommandees %}

                <tr>
                    <td class="fw-medium text-dark">{{ ligne.piece.reference }} - {{ ligne.piece.libelle }}</td>
                    <td class="text-center">{{ ligne.quantite }}</td>
                    <td class="text-end text-muted">{{ ligne.prix|number_format(2, ',', ' ') }} €</td>
                    <td class="text-end fw-bold text-dark">{{ (ligne.prix * ligne.quantite)|number_format(2, ',', ' ') }} €</td>
                    <td class="text-end">
                        {% if isCommandee or isExpired %}
                            <span class="badge bg-light text-muted border" title="{{ isExpired ? 'Devis expiré' : 'Ligne verrouillée : copiée dans une commande.' }}">
                                <i class="bi bi-lock-fill me-1"></i> Verrouillé
                            </span>
                        {% else %}
                            <div class="d-flex justify-content-end gap-2 action-buttons">
                                <form method="post" action="{{ path('commercial_devis_ligne_delete', {id: ligne.id}) }}" onsubmit="return confirm('Êtes-vous sûr ?');" class="mb-0">
                                    <input type="hidden" name="_token" value="{{ csrf_token('delete_ligne_' ~ ligne.id) }}">
                                    <button class="btn btn-sm btn-outline-danger" type="submit" title="Supprimer la ligne">
                                        <i class="bi bi-trash"></i>
                                    </button>
                                </form>
                            </div>
                        {% endif %}
                    </td>
                </tr>
            {% endfor %}
            </tbody>
        </table>
    </div>
</div>
