{{ form_start(form, {'attr': {'id': 'form-client'}}) }}

<div class="row g-3">
    {# --- Section Informations Générales --- #}
    <div class="col-12 mt-0">
        <h6 class="text-muted mb-2 pb-1 border-bottom">Informations générales</h6>
    </div>

    <div class="col-12">
        {{ form_row(form.raisonSociale) }}
        <div class="form-text mt-1"><i class="bi bi-info-circle me-1"></i>Laissez vide s'il s'agit d'un particulier.</div>
    </div>

    <div class="col-md-6">
        {{ form_row(form.prenom) }}
    </div>

    <div class="col-md-6">
        {{ form_row(form.nom) }}
    </div>

    {# --- Section Coordonnées --- #}
    <div class="col-12 mt-4">
        <h6 class="text-muted mb-2 pb-1 border-bottom">Coordonnées</h6>
    </div>

    <div class="col-md-6">
        {{ form_row(form.email) }}
    </div>

    <div class="col-md-6">
        {{ form_row(form.telephone) }}
    </div>
</div>

<hr class="my-4">

<div class="d-flex justify-content-end gap-2">
    <button type="button" class="btn btn-outline-secondary" onclick="closeModal()">Annuler</button>
    <button type="submit" class="btn btn-primary">
        {{ client.id ? 'Mettre à jour' : 'Créer le client' }}
    </button>
</div>

{{ form_end(form) }}
