{{ form_start(form, {'attr': {'id': 'form-lier-devis'}}) }}
<div class="row g-3">
    <div class="col-12">
        <div class="alert alert-info py-2 small d-flex align-items-center">
            <i class="bi bi-link-45deg me-2 fs-5"></i>
            <div>
                Associez un autre devis valide du client <strong>{{ commande.client.raisonSociale ?: commande.client.nomComplet }}</strong> pour pouvoir piocher des pièces dedans.
            </div>
        </div>
    </div>

    <div class="col-12">
        {{ form_row(form.devis) }}
    </div>
</div>

<hr class="my-4">

<div class="d-flex justify-content-end gap-2">
    <button type="button" class="btn btn-outline-secondary" onclick="closeModal()">Annuler</button>
    <button type="submit" class="btn btn-primary">Lier ce devis</button>
</div>
{{ form_end(form) }}
