{{ form_start(form, {'attr': {'id': 'form-commande-ligne'}}) }}
<div class="row g-3">
    <div class="col-12">
        <div class="alert alert-info py-2 small d-flex align-items-center">
            <i class="bi bi-info-circle me-2 fs-5"></i>
            <div>La pièce et sa quantité seront copiées à l'identique depuis le devis choisi.</div>
        </div>
    </div>

    <div class="col-12">
        {{ form_row(form.devisLigne) }}
    </div>
</div>

<hr class="my-4">

<div class="d-flex justify-content-end gap-2">
    <button type="button" class="btn btn-outline-secondary" onclick="closeModal()">Annuler</button>
    <button type="submit" class="btn btn-primary" {{ form.devisLigne.vars.disabled ? 'disabled' : '' }}>Valider l'ajout</button>
</div>
{{ form_end(form) }}
