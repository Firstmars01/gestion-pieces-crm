{% extends './base.html.twig' %}

{% block title %}Administration des utilisateurs{% endblock %}

{% block body %}
    <div class="container-fluid py-4 admin-user-page">
        <div class="admin-user-page__header d-flex flex-column flex-md-row justify-content-between align-items-md-start gap-3 mb-4">

            <div>
                <h1 class="h3 admin-user-page__title">Administration des utilisateurs</h1>
                <p class="admin-user-page__subtitle text-muted">Gérez les comptes, leurs rôles et leur statut d'activation.</p>
            </div>

            <div class="d-flex flex-column flex-sm-row gap-2">
                {# Formulaire de recherche #}
                <form method="get" class="mb-0">
                    <div class="input-group">
                        <label>
                            <input type="text" name="q" class="form-control" placeholder="Rechercher..." value="{{ app.request.query.get('q') }}">
                        </label>

                        {% if app.request.query.get('q') %}
                            <a href="{{ path('admin_user_index') }}" class="btn btn-outline-secondary d-flex align-items-center justify-content-center" title="Effacer la recherche">
                                <i class="bi bi-x-lg"></i>
                            </a>
                        {% endif %}

                        <button class="btn btn-primary d-flex align-items-center justify-content-center" type="submit">
                            <i class="bi bi-search"></i>
                        </button>
                    </div>
                </form>

                <button type="button" onclick="openModalAjax('Nouvel utilisateur', '{{ path('admin_user_new') }}')" class="btn btn-primary text-nowrap">
                    <i class="bi bi-person-plus me-1"></i> Nouvel utilisateur
                </button>

            </div>
        </div>

        <div class="card shadow-sm border-0 admin-user-card overflow-hidden">
            <div class="table-responsive">
                <table class="table align-middle mb-0 table-sortable">
                    <thead class="table-light">
                    <tr>
                        <th scope="col">{{ knp_pagination_sortable(users, 'Utilisateur', 'u.nom') }}</th>
                        <th scope="col">{{ knp_pagination_sortable(users, 'Email', 'u.email') }}</th>
                        <th scope="col">Rôles</th>
                        <th scope="col">{{ knp_pagination_sortable(users, 'Actif', 'u.actif') }}</th>
                        <th scope="col" class="text-end"></th>
                    </tr>
                    </thead>
                    <tbody>
                    {% for user in users %}
                        <tr>
                            <td>
                                <div class="d-flex align-items-center">
                                    <div class="avatar-initials avatar-initials-primary me-2">
                                        {{ user.nom|first|upper }}{{ user.prenom|first|upper }}
                                    </div>
                                    <div class="admin-user-table__identity">
                                        <div class="fw-semibold">{{ user.nom }} {{ user.prenom }}</div>
                                    </div>
                                </div>
                            </td>
                            <td>{{ user.email }}</td>
                            <td>
                                <div class="admin-user-roles gap-1 d-flex flex-wrap">
                                    {% for role in user.userRoles %}
                                        <span class="badge text-bg-secondary">{{ role.code }}</span>
                                    {% endfor %}
                                </div>
                            </td>
                            <td>
                                {% if user.actif %}
                                    <span class="badge text-bg-success">Oui</span>
                                {% else %}
                                    <span class="badge text-bg-danger">Non</span>
                                {% endif %}
                            </td>
                            <td class="text-end">
                                <div class="admin-user-actions d-flex justify-content-end gap-2 action-buttons">

                                    <button type="button"
                                            onclick="openModalAjax('Modifier l\'utilisateur', '{{ path('admin_user_edit', {id: user.id}) }}')"
                                            class="btn btn-sm btn-outline-primary"
                                            title="Modifier">
                                        <i class="bi bi-pencil-square"></i>
                                    </button>

                                    {% if app.user and app.user.id != user.id %}
                                        <form method="post" action="{{ path('admin_user_delete', {id: user.id}) }}" onsubmit="return confirm('Êtes-vous sûr de vouloir supprimer cet utilisateur ?');">
                                            <input type="hidden" name="_token" value="{{ csrf_token('delete_user_' ~ user.id) }}">
                                            <button class="btn btn-sm btn-outline-danger" type="submit" title="Supprimer">
                                                <i class="bi bi-trash"></i>
                                            </button>
                                        </form>
                                    {% else %}
                                        <button class="btn btn-sm btn-outline-danger" type="button" disabled title="Vous ne pouvez pas vous supprimer vous-même">
                                            <i class="bi bi-trash"></i>
                                        </button>
                                    {% endif %}

                                </div>
                            </td>
                        </tr>
                    {% else %}
                        <tr>
                            <td colspan="5" class="text-center text-muted py-4 admin-user-empty-state">
                                Aucun utilisateur trouvé.
                            </td>
                        </tr>
                    {% endfor %}
                    </tbody>
                </table>
            </div>
        </div>

        {# Affichage de la pagination en bas au centre #}
        <div class="pagination-container pagination-pill">
            {{ knp_pagination_render(users) }}
        </div>
    </div>
{% endblock %}

{% block javascripts %}
    <script src="{{ asset('js/modal_admin.js') }}"></script>
{% endblock %}
