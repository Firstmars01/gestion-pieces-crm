{# templates/admin/user/_form.html.twig #}
<form method="post" class="admin-user-form">
    <input type="hidden" name="_token" value="{{ csrf_token(form_token_id) }}">

    {% if errors is not empty %}
        <div class="alert alert-danger admin-user-form__errors" role="alert">
            <strong>La sauvegarde a échoué :</strong>
            <ul class="mb-0 mt-2">
                {% for error in errors %}
                    <li>{{ error }}</li>
                {% endfor %}
            </ul>
        </div>
    {% endif %}

    <div class="row g-3">
        <div class="col-md-6">
            <label for="email" class="form-label">Email</label>
            <input type="email" id="email" name="email" class="form-control" value="{{ user.email }}" autocomplete="email" required>
        </div>

        <div class="col-md-6">
            <label for="password" class="form-label">
                Mot de passe{% if is_edit %} <span class="text-muted small">(laisser vide pour conserver)</span>{% endif %}
            </label>
            <input type="password" id="password" name="password" class="form-control" autocomplete="new-password" {% if not is_edit %}required{% endif %}>
        </div>

        <div class="col-md-6">
            <label for="nom" class="form-label">Nom</label>
            <input type="text" id="nom" name="nom" class="form-control" value="{{ user.nom }}" autocomplete="family-name" required>
        </div>

        <div class="col-md-6">
            <label for="prenom" class="form-label">Prénom</label>
            <input type="text" id="prenom" name="prenom" class="form-control" value="{{ user.prenom }}" autocomplete="given-name" required>
        </div>

        <div class="col-12 mt-4">
            <div class="d-flex align-items-center justify-content-between mb-2">
                <label class="form-label mb-0 fw-bold">Rôles</label>
                <small class="text-muted">ROLE_USER est toujours ajouté automatiquement</small>
            </div>

            <div class="d-flex flex-wrap gap-2">
                {% for role in roles %}
                    <div>
                        <input class="btn-check" type="checkbox" name="roles[]" id="role_{{ role.id }}" value="{{ role.id }}" {% if role.id in selected_role_ids %}checked{% endif %}>
                        <label class="btn btn-outline-primary btn-sm" for="role_{{ role.id }}">{{ role.code }}</label>
                    </div>
                {% else %}
                    <div class="text-muted">Aucun rôle n'est disponible.</div>
                {% endfor %}
            </div>
        </div>

        <div class="col-12 mt-4">
            <div class="form-check form-switch">
                <input class="form-check-input" type="checkbox" id="actif" name="actif" {% if user.actif %}checked{% endif %}>
                <label class="form-check-label fw-bold" for="actif">Compte actif (autorisé à se connecter)</label>
            </div>
        </div>
    </div>

    <hr class="my-4">

    <div class="d-flex justify-content-end gap-2">
        {# 🚀 MODIFICATION : Bouton annuler intelligent #}
        {% if app.request.xmlHttpRequest %}
            <button type="button" class="btn btn-outline-secondary" onclick="closeModal()">Annuler</button>
        {% else %}
            <a href="{{ path('admin_user_index') }}" class="btn btn-outline-secondary">Annuler</a>
        {% endif %}

        <button type="submit" class="btn btn-primary">{{ submit_label|default('Enregistrer') }}</button>
    </div>
</form>
