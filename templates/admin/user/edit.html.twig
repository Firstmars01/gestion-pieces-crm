{# templates/admin/user/edit.html.twig #}
{% extends app.request.xmlHttpRequest ? 'base_ajax.html.twig' : 'base.html.twig' %}

{% block title %}Modifier l'utilisateur{% endblock %}

{% block body %}
    <div class="{{ app.request.xmlHttpRequest ? '' : 'container-fluid py-4' }}">

        {% if not app.request.xmlHttpRequest %}
            <div class="mb-4">
                <h1 class="h3 mb-1">Modifier l'utilisateur</h1>
                <p class="text-muted">Mettez à jour les informations du compte {{ user.fullName ?: user.email }}.</p>
            </div>
        {% endif %}

        {% include 'admin/user/_form.html.twig' with {
            user: user,
            roles: roles,
            errors: errors,
            selected_role_ids: selected_role_ids,
            form_token_id: form_token_id,
            submit_label: 'Enregistrer les modifications',
            is_edit: true,
        } %}
    </div>
{% endblock %}
