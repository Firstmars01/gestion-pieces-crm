{% extends 'base.html.twig' %}

{% block title %}Modifier l'utilisateur{% endblock %}

{% block stylesheets %}
    <link rel="stylesheet" href="{{ asset('styles/admin.css') }}">
{% endblock %}

{% block body %}
    <div class="container-fluid py-4 admin-user-page">
        <div class="admin-user-page__header d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-2">
            <div>
                <h1 class="h3 admin-user-page__title">Modifier l'utilisateur</h1>
                <p class="admin-user-page__subtitle">Mettez à jour les informations du compte {{ user.fullName ?: user.email }}.</p>
            </div>
        </div>

        {% include 'admin/user/_form.html.twig' with {
            user: user,
            roles: roles,
            errors: errors,
            selected_role_ids: selected_role_ids,
            form_token_id: form_token_id,
            submit_label: 'Enregistrer les modifications',
            is_edit: true,
        } %}
    </div>
{% endblock %}

