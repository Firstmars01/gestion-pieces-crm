{# templates/admin/user/new.html.twig #}
{% extends app.request.xmlHttpRequest ? 'base_ajax.html.twig' : 'base.html.twig' %}

{% block title %}Nouvel utilisateur{% endblock %}

{% block body %}
    <div class="{{ app.request.xmlHttpRequest ? '' : 'container-fluid py-4' }}">

        {# On masque le titre s'il est dans la modale car la modale a déjà son titre #}
        {% if not app.request.xmlHttpRequest %}
            <div class="mb-4">
                <h1 class="h3 mb-1">Créer un utilisateur</h1>
                <p class="text-muted">Ajoutez un nouvel utilisateur et attribuez-lui les rôles nécessaires.</p>
            </div>
        {% endif %}

        {% include 'admin/user/_form.html.twig' with {
            user: user,
            roles: roles,
            errors: errors,
            selected_role_ids: selected_role_ids,
            form_token_id: form_token_id,
            submit_label: 'Créer l\'utilisateur',
            is_edit: false,
        } %}
    </div>
{% endblock %}
