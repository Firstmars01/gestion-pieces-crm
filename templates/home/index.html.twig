{% extends 'base.html.twig' %}

{% block title %}Tableau de bord{% endblock %}

{% block body %}
    <div class="container-fluid py-4">

        {# 1. En-tête avec la date du jour #}
        <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
            <div>
                <h1 class="h3 mb-1 fw-bold text-dark">
                    Tableau de bord
                </h1>
                <p class="text-muted mb-0">Ravi de vous revoir, <span class="fw-semibold text-dark">{{ app.user.fullName }}</span> !</p>
            </div>
            <div>
                <div class="badge bg-light text-secondary border px-3 py-2 fs-6 fw-normal">
                    <i class="bi bi-calendar3 me-1"></i> {{ "now"|date("d/m/Y") }}
                </div>
            </div>
        </div>

        {# 2. Bannière de bienvenue #}
        <div class="card border-0 shadow-sm rounded-3 mb-5 overflow-hidden">
            <div class="card-body p-4 p-md-5 bg-primary bg-opacity-10">
                <div class="row align-items-center">
                    <div class="col-md-8">
                        <h2 class="h4 fw-bold text-primary mb-2">Bienvenue sur votre espace !</h2>
                        <p class="mb-0 text-muted">
                            C'est ici que vous retrouverez l'essentiel de vos activités. Utilisez le menu de navigation pour accéder aux différents modules de l'application.
                        </p>
                    </div>
                </div>
            </div>
        </div>

        {# 3. Grille de cartes d'informations (Placeholder à adapter selon tes besoins) #}
        <div class="row g-4">

            {# Carte d'info 1 : Rôle #}
            <div class="col-sm-6 col-lg-4">
                <div class="card border-0 shadow-sm h-100 rounded-3">
                    <div class="card-body">
                        <div class="d-flex align-items-center mb-3">
                            <div class="bg-info bg-opacity-10 p-3 rounded-3 text-info me-3">
                                <i class="bi bi-person-badge fs-5"></i>
                            </div>
                            <h6 class="mb-0 fw-bold text-muted">Votre compte</h6>
                        </div>
                        <h4 class="mb-0 fw-bold text-dark fs-5 text-truncate">
                            {{ app.user.email }}
                        </h4>
                    </div>
                </div>
            </div>

            {# Carte d'info 2 : Rôle #}
            <div class="col-sm-6 col-lg-4">
                <div class="card border-0 shadow-sm h-100 rounded-3">
                    <div class="card-body">
                        <div class="d-flex align-items-center mb-3">
                            <div class="bg-success bg-opacity-10 p-3 rounded-3 text-success me-3">
                                <i class="bi bi-shield-lock fs-5"></i>
                            </div>
                            <h6 class="mb-0 fw-bold text-muted">Rôle</h6>
                        </div>
                        <h4 class="mb-0 fw-bold text-dark fs-5 text-truncate">
                            {{ app.user.roles|join(', ') }}
                        </h4>
                    </div>
                </div>
            </div>

            {# Carte d'info 3 : Accès rapide #}
            <div class="col-sm-6 col-lg-4">
                <div class="card border-0 shadow-sm h-100 rounded-3 bg-light">
                    <div class="card-body d-flex flex-column justify-content-center align-items-center text-center">
                        <i class="bi bi-compass text-muted fs-3 mb-2"></i>
                        <p class="text-muted mb-0 small">Naviguez via le menu pour commencer</p>
                    </div>
                </div>
            </div>

        </div>

    </div>
{% endblock %}
