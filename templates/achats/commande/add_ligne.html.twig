{{ form_start(form, {'attr': {'id': 'form-add-ligne'}}) }}

<div class="row g-3">
    <div class="col-12">
        {{ form_row(form.piece) }}
    </div>
    <div class="col-md-6">
        {{ form_row(form.quantite) }}
    </div>
    <div class="col-md-6">
        {{ form_row(form.prixAchat) }}
    </div>
</div>

<hr class="my-4">

<div class="d-flex justify-content-end gap-2">
    <button type="button" class="btn btn-outline-secondary" onclick="closeModal()">Annuler</button>
    <button type="submit" class="btn btn-primary">
        Ajouter la pièce
    </button>
</div>

{{ form_end(form) }}
