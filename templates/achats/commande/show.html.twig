{% extends 'base.html.twig' %}

{% block title %}Détail Commande Achat #{{ commande.id }}{% endblock %}

{% block body %}
    <div class="container-fluid py-4 max-w-1000px">
        <div class="mb-4">
            <a href="{{ path('achats_commande_index') }}" class="btn btn-sm btn-outline-secondary mb-2">
                <i class="bi bi-arrow-left"></i> Retour aux commandes
            </a>
        </div>



        {# EN-TÊTE DE LA COMMANDE #}
        <div class="card shadow-sm border-0 mb-4">
            <div class="card-body d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3">
                <div>
                    <div class="d-flex align-items-center gap-2 mb-2">
                        <h5 class="mb-0 fw-bold text-dark text-uppercase">
                            Commande Achat #{{ commande.id }}
                        </h5>
                        <button type="button"
                                onclick="openModalAjax('Modifier commande', '{{ path('achats_commande_edit', {id: commande.id}) }}')"
                                class="btn btn-sm btn-outline-primary"
                                title="Modifier les dates">
                            <i class="bi bi-pencil-square"></i>
                        </button>
                    </div>

                    <div class="text-muted fw-bold">
                        <i class="bi bi-building me-1"></i> {{ commande.fournisseur.raisonSociale }}
                    </div>

                    <div class="text-muted small mt-1">
                        Passée le {{ commande.dateCommande|date('d/m/Y') }} •
                        {% if commande.dateReelle %}
                            <span class="text-success fw-bold"><i class="bi bi-check-circle"></i> Livrée le {{ commande.dateReelle|date('d/m/Y') }}</span>
                        {% else %}
                            <span class="{{ date() > commande.datePrevue ? 'text-danger fw-bold' : 'text-warning text-dark fw-bold' }}">
                        Prévue le {{ commande.datePrevue|date('d/m/Y') }}
                    </span>
                        {% endif %}
                    </div>
                </div>

                <div class="text-md-end">
                    <div class="fs-4 fw-bold text-primary">{{ commande.getTotal()|number_format(2, ',', ' ') }} €</div>
                    <div class="text-muted small">Montant total de l'achat</div>
                </div>
            </div>
        </div>

        {% if commande.dateReelle %}
            <div class="alert alert-success d-flex align-items-center mb-4 shadow-sm border-0 border-start border-success border-4 bg-success bg-opacity-10">
                <i class="bi bi-check-circle-fill fs-2 me-3 text-success"></i>
                <div>
                    <h4 class="alert-heading h6 fw-bold mb-1 text-success">Commande livrée !</h4>
                    <p class="mb-0 small text-dark">
                        Cette commande a été réceptionnée le <strong>{{ commande.dateReelle|date('d/m/Y') }}</strong>. L'inventaire a été mis à jour.
                    </p>
                </div>
            </div>
        {% elseif date() > commande.datePrevue %}
            <div class="alert alert-danger d-flex align-items-center mb-4 shadow-sm border-0 border-start border-danger border-4 bg-danger bg-opacity-10">
                <i class="bi bi-exclamation-triangle-fill fs-2 me-3 text-danger"></i>
                <div>
                    <h4 class="alert-heading h6 fw-bold mb-1 text-danger">Commande en retard</h4>
                    <p class="mb-0 small text-dark">
                        La livraison était prévue pour le <strong>{{ commande.datePrevue|date('d/m/Y') }}</strong>. Il est conseillé de relancer le fournisseur.
                    </p>
                </div>
            </div>
        {% else %}
            {# UTILISATION DE TON ORANGE-ROUGE ICI #}
            <div class="alert d-flex align-items-center mb-4 shadow-sm border-0 border-start border-orange-rouge border-4 bg-orange-rouge-light">
                <i class="bi bi-clock-fill fs-2 me-3 text-orange-rouge"></i>
                <div>
                    <h4 class="alert-heading h6 fw-bold mb-1 text-orange-rouge">Commande en cours</h4>
                    <p class="mb-0 small text-dark">
                        Le fournisseur prépare votre commande. La livraison est attendue pour le <strong>{{ commande.datePrevue|date('d/m/Y') }}</strong>.
                    </p>
                </div>
            </div>
        {% endif %}

        {# LISTE DES PIÈCES DE LA COMMANDE #}
        <div class="card shadow-sm border-0 overflow-hidden mb-5">
            <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center border-bottom-0">
                <h6 class="mb-0 fw-bold"><i class="bi bi-box-seam me-2"></i>Contenu de la commande</h6>

                {# Bouton inactif si la commande est déjà livrée #}
                <button type="button" class="btn btn-sm btn-outline-primary" {{ commande.dateReelle ? 'disabled' : '' }} onclick="openModalAjax('Ajouter une pièce', '{{ path('achats_commande_add_ligne', {id: commande.id}) }}')">
                    <i class="bi bi-plus-circle me-1"></i> Ajouter une pièce
                </button>
            </div>

            <div class="table-responsive">
                <table class="table align-middle mb-0">
                    <thead class="table-light">
                    <tr>
                        <th>Référence Pièce</th>
                        <th class="text-center">Quantité</th>
                        <th class="text-end">Prix Achat Unitaire</th>
                        <th class="text-end">Total Ligne</th>
                        <th class="text-end"></th> {# Colonne pour la corbeille #}
                    </tr>
                    </thead>
                    <tbody>
                    {% for ligne in commande.lignes %}
                        <tr>
                            <td class="fw-medium text-dark">{{ ligne.piece.reference }} - {{ ligne.piece.libelle }}</td>
                            <td class="text-center">{{ ligne.quantite }}</td>
                            <td class="text-end text-muted">{{ ligne.prixAchat|number_format(2, ',', ' ') }} €</td>
                            <td class="text-end fw-bold text-dark">{{ (ligne.prixAchat * ligne.quantite)|number_format(2, ',', ' ') }} €</td>
                            <td class="text-end">
                                {# On affiche la corbeille uniquement si la commande n'est pas encore livrée #}
                                {% if not commande.dateReelle %}
                                    <form method="post" action="{{ path('achats_commande_ligne_delete', {id: ligne.id}) }}" onsubmit="return confirm('Êtes-vous sûr de vouloir retirer cette pièce de la commande ?');" class="mb-0 d-inline-block">
                                        <input type="hidden" name="_token" value="{{ csrf_token('delete_ligne_' ~ ligne.id) }}">
                                        <button class="btn btn-sm btn-outline-danger py-1" type="submit" title="Supprimer la ligne">
                                            <i class="bi bi-trash"></i>
                                        </button>
                                    </form>
                                {% else %}
                                    <i class="bi bi-lock-fill text-muted" title="Vérouillé (Commande livrée)"></i>
                                {% endif %}
                            </td>
                        </tr>
                    {% else %}
                        <tr>
                            <td colspan="5" class="text-center text-muted py-4 fst-italic">
                                Aucune pièce dans cette commande d'achat.
                            </td>
                        </tr>
                    {% endfor %}
                    </tbody>
                </table>
            </div>
        </div>
    </div>
{% endblock %}
