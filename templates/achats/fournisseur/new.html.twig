{{ form_start(form, {'attr': {'id': 'form-fournisseur'}}) }}

<div class="row g-3">
    <div class="col-12">
        {{ form_row(form.raisonSociale) }}
    </div>
    <div class="col-md-6">
        {{ form_row(form.email) }}
    </div>
    <div class="col-md-6">
        {{ form_row(form.telephone) }}
    </div>
</div>

<hr class="my-4">

<div class="d-flex justify-content-end gap-2">
    <button type="button" class="btn btn-outline-secondary" onclick="closeModal()">Annuler</button>
    <button type="submit" class="btn btn-primary">
        {{ fournisseur.id ? 'Enregistrer les modifications' : 'Ajouter le fournisseur' }}
    </button>
</div>

{{ form_end(form) }}
