{% extends 'base.html.twig' %}

{% block title %}Gestion des Fournisseurs{% endblock %}

{% block body %}
    <div class="container-fluid py-4">
        <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-start gap-3 mb-4">
            <div>
                <h1 class="h3 mb-1">Fournisseurs</h1>
                <p class="text-muted mb-0">Gérez la liste de vos fournisseurs, leurs coordonnées et les pièces qu'ils vous vendent.</p>
            </div>

            <div class="d-flex flex-column flex-sm-row gap-2">
                <form method="get" class="mb-0">
                    <div class="input-group">
                        <input type="text" name="q" class="form-control" placeholder="Rechercher..." value="{{ app.request.query.get('q') }}">
                        {% if app.request.query.get('q') %}
                            <a href="{{ path('achats_fournisseur_index') }}" class="btn btn-outline-secondary d-flex align-items-center justify-content-center" title="Effacer la recherche">
                                <i class="bi bi-x-lg"></i>
                            </a>
                        {% endif %}
                        <button class="btn btn-primary d-flex align-items-center justify-content-center" type="submit">
                            <i class="bi bi-search"></i>
                        </button>
                    </div>
                </form>

                <button type="button" onclick="openModalAjax('Nouveau fournisseur', '{{ path('achats_fournisseur_new') }}')" class="btn btn-primary text-nowrap">
                    <i class="bi bi-plus-circle me-1"></i> Ajouter
                </button>
            </div>
        </div>

        <div class="card shadow-sm border-0 overflow-hidden">
            <div class="table-responsive">
                <table class="table align-middle mb-0 table-sortable">
                    <thead class="table-light">
                    <tr>
                        <th scope="col">{{ knp_pagination_sortable(fournisseurs, 'ID', 'f.id') }}</th>
                        <th scope="col">{{ knp_pagination_sortable(fournisseurs, 'Raison Sociale', 'f.raisonSociale') }}</th>
                        <th scope="col">{{ knp_pagination_sortable(fournisseurs, 'Email', 'f.email') }}</th>
                        <th scope="col">{{ knp_pagination_sortable(fournisseurs, 'Téléphone', 'f.telephone') }}</th>
                        <th scope="col" class="text-center">Pièces fournies</th>
                        <th scope="col" class="text-end"></th>
                    </tr>
                    </thead>
                    <tbody>
                    {% for fournisseur in fournisseurs %}
                        <tr>
                            <td class="text-muted">#{{ fournisseur.id }}</td>
                            <td class="fw-bold text-dark">{{ fournisseur.raisonSociale }}</td>
                            <td>
                                {% if fournisseur.email %}
                                    <a href="mailto:{{ fournisseur.email }}" class="text-decoration-none">{{ fournisseur.email }}</a>
                                {% else %}
                                    <span class="text-muted fst-italic">-</span>
                                {% endif %}
                            </td>
                            <td>
                                {% if fournisseur.telephone %}
                                    {{ fournisseur.telephone }}
                                {% else %}
                                    <span class="text-muted fst-italic">-</span>
                                {% endif %}
                            </td>
                            <td class="text-center">
                                <span class="badge bg-light text-dark border">
                                    {{ fournisseur.pieces|length }} pièce(s)
                                </span>
                            </td>
                            <td class="text-end">
                                <div class="d-flex justify-content-end gap-2 action-buttons">
                                    <a href="{{ path('achats_fournisseur_show', {id: fournisseur.id}) }}"
                                       class="btn btn-sm btn-outline-info"
                                       title="Consulter les détails">
                                        <i class="bi bi-info-circle"></i> Consulter
                                    </a>

                                    <button type="button"
                                            onclick="openModalAjax('Modifier le fournisseur', '{{ path('achats_fournisseur_edit', {id: fournisseur.id}) }}')"
                                            class="btn btn-sm btn-outline-primary"
                                            title="Modifier">
                                        <i class="bi bi-pencil-square"></i>
                                    </button>
                                </div>
                            </td>
                        </tr>
                    {% else %}
                        <tr>
                            <td colspan="6" class="text-center text-muted py-4">
                                Aucun fournisseur trouvé.
                            </td>
                        </tr>
                    {% endfor %}
                    </tbody>
                </table>
            </div>
        </div>

        <div class="pagination-container pagination-pill mt-3">
            {{ knp_pagination_render(fournisseurs) }}
        </div>
    </div>
{% endblock %}
