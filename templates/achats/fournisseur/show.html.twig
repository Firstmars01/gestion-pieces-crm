{% extends 'base.html.twig' %}

{% block title %}Fiche Fournisseur - {{ fournisseur.raisonSociale }}{% endblock %}

{% block body %}
    <div class="container-fluid py-4 max-w-1000px">
        <div class="mb-4">
            <a href="{{ path('achats_fournisseur_index') }}" class="btn btn-sm btn-outline-secondary mb-2">
                <i class="bi bi-arrow-left"></i> Retour aux fournisseurs
            </a>
        </div>

        {# EN-TÊTE DU FOURNISSEUR #}
        <div class="card shadow-sm border-0 mb-4">
            <div class="card-body d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3">
                <div>
                    <div class="d-flex align-items-center gap-2 mb-2">

                        <h5 class="mb-1 fw-bold text-dark text-uppercase">
                            {{ fournisseur.raisonSociale }}
                        </h5>
                        <button type="button"
                                onclick="openModalAjax('Modifier le fournisseur', '{{ path('achats_fournisseur_edit', {id: fournisseur.id}) }}')"
                                class="btn btn-sm btn-outline-primary"
                                title="Modifier">
                            <i class="bi bi-pencil-square"></i>
                        </button>
                    </div>

                    <div class="text-muted">
                        <i class="bi bi-envelope me-1"></i> {{ fournisseur.email ?: 'Non renseigné' }}
                        <span class="mx-2">•</span>
                        <i class="bi bi-telephone me-1"></i> {{ fournisseur.telephone ?: 'Non renseigné' }}
                    </div>
                </div>


            </div>
        </div>


        {# CATALOGUE DES PIÈCES #}
        <div class="card shadow-sm border-0 overflow-hidden mb-5">
            <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center border-bottom-0">
                <h6 class="mb-0 fw-bold"><i class="bi bi-box-seam me-2"></i>Catalogue des pièces fournies ({{ fournisseur.pieces|length }})</h6>

                {# BOUTON POUR OUVRIR LA MODALE D'AJOUT DE PIECE #}
                <button type="button" class="btn btn-sm btn-outline-primary" onclick="openModalAjax('Ajouter une pièce', '{{ path('achats_fournisseur_add_piece', {id: fournisseur.id}) }}')">
                    <i class="bi bi-plus-circle me-1"></i> Nouvelle pièce
                </button>
            </div>

            <div class="table-responsive">
                <table class="table align-middle mb-0">
                    <thead class="table-light">
                    <tr>
                        <th>Référence</th>
                        <th>Libellé</th>
                        <th class="text-end">Prix Catalogue</th>
                        <th class="text-end">En stock</th>
                        <th class="text-end"></th>
                    </tr>
                    </thead>
                    <tbody>
                    {% for piece in fournisseur.pieces %}
                        <tr>
                            <td class="fw-medium text-dark">{{ piece.reference }}</td>
                            <td>{{ piece.libelle }}</td>
                            <td class="text-end fw-semibold text-primary">
                                {% if piece.prixCatalogue is not null %}
                                    {{ piece.prixCatalogue|number_format(2, ',', ' ') }} €
                                {% else %}
                                    <span class="text-muted">—</span>
                                {% endif %}
                            </td>
                            <td class="text-end">{{ piece.quantiteStock }}</td>
                            <td class="text-end">
                                <div class="d-flex justify-content-end gap-2 action-buttons">
                                    <button type="button"
                                            onclick="openModalAjax('Modifier le prix catalogue', '{{ path('achats_fournisseur_piece_prix_catalogue', {fournisseur: fournisseur.id, piece: piece.id}) }}')"
                                            class="btn btn-sm btn-outline-primary"
                                            title="Modifier l'étape">
                                        <i class="bi bi-pencil-square"></i>
                                    </button>
                                </div>
                            </td>
                        </tr>
                    {% else %}
                        <tr>
                            <td colspan="5" class="text-center text-muted py-4 fst-italic">
                                Ce fournisseur ne vend encore aucune pièce. Ajoutez-en une !
                            </td>
                        </tr>
                    {% endfor %}
                    </tbody>
                </table>
            </div>
        </div>
    </div>
{% endblock %}
