{{ form_start(form, {'attr': {'id': 'form-add-piece-fournisseur'}}) }}

<div class="alert alert-light border shadow-sm mb-4">
    <i class="bi bi-info-circle text-primary me-2"></i>
    Sélectionnez une pièce pour l'ajouter au catalogue de <strong>{{ fournisseur.raisonSociale }}</strong> et ajustez son prix d'achat si nécessaire.
</div>

<div class="row g-3 align-items-start">
    <div class="col-md-8">
        {{ form_row(form.piece) }}
    </div>
    <div class="col-md-4">
        {{ form_row(form.prixAchat) }}
    </div>
</div>

<hr class="my-4">

<div class="d-flex justify-content-end gap-2">
    <button type="button" class="btn btn-outline-secondary" onclick="closeModal()">Annuler</button>
    <button type="submit" class="btn btn-primary">
        Associer la pièce
    </button>
</div>

{{ form_end(form) }}
