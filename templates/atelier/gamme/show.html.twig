{% extends 'base.html.twig' %}

{% block title %}Détails de la Gamme | {{ gamme.libelle }}{% endblock %}

{% block body %}
    <div class="container-fluid py-4">
        <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-start gap-3 mb-4">
            <div>
                <a href="{{ path('atelier_gamme_index') }}" class="btn btn-sm btn-outline-secondary mb-2">
                    <i class="bi bi-arrow-left"></i> Retour aux gammes
                </a>
                <h1 class="h3 mb-1">Gamme : {{ gamme.libelle }}</h1>
                <p class="text-muted mb-0">
                    Pièce associée : {% if gamme.piece %}<strong>{{ gamme.piece.reference }}</strong>{% else %}<span class="fst-italic text-warning">Aucune</span>{% endif %}
                </p>
            </div>

            <div class="d-flex gap-2">
                {# Le bouton d'ajout (il ne fait rien pour l'instant, on créera la modale plus tard) #}
                <button type="button" onclick="openModalAjax('Nouvelle étape', '{{ path('atelier_gamme_etape_new', {id: gamme.id}) }}')" class="btn btn-primary text-nowrap">
                    <i class="bi bi-plus-circle me-1"></i> Ajouter une étape
                </button>
            </div>
        </div>

        <div class="card shadow-sm border-0 overflow-hidden">
            <div class="table-responsive">
                <table class="table align-middle mb-0">
                    <thead class="table-light">
                    <tr>
                        <th scope="col" style="width: 80px;">Ordre</th>
                        <th scope="col">Opération</th>
                        <th scope="col">Temps prévu</th>
                        <th scope="col">Machine / Poste</th>
                        <th scope="col" class="text-end"></th>
                    </tr>
                    </thead>
                    <tbody>
                    {# On trie automatiquement les opérations par leur ordre (1, 2, 3...) #}
                    {% for etape in gamme.gammeOperations|sort((a, b) => a.ordre <=> b.ordre) %}
                        <tr>
                            <td class="fw-bold text-muted">Étape {{ etape.ordre }}</td>
                            <td class="fw-semibold">{{ etape.operation.libelle }}</td>
                            <td>
                                <span class="bi-stopwatch badge bg-light text-dark border"> {{ etape.operation.tempsPrevu }} min</span>
                            </td>
                            <td>
                                {% if etape.operation.posteMachine %}
                                    <span class="badge bg-light text-dark border">
                                            {{ etape.operation.posteMachine.machine.libelle }}
                                        </span>
                                    <span class="badge bg-light text-dark border">
                                            {{ etape.operation.posteMachine.poste.libelle }}
                                        </span>
                                {% else %}
                                    <span class="text-muted fst-italic">Non défini</span>
                                {% endif %}
                            </td>
                            <td class="text-end">
                                <div class="d-flex justify-content-end gap-2 action-buttons">

                                    {# BOUTON MODIFIER : Il va appeler ta route 'atelier_gamme_etape_edit' #}
                                    <button type="button"
                                            onclick="openModalAjax('Modifier l\'étape', '{{ path('atelier_gamme_etape_edit', {id: etape.id}) }}')"
                                            class="btn btn-sm btn-outline-primary"
                                            title="Modifier l'étape">
                                        <i class="bi bi-pencil-square"></i>
                                    </button>

                                    {# BOUTON SUPPRIMER : Il va appeler ta route 'atelier_gamme_etape_delete' #}
                                    <form method="post" action="{{ path('atelier_gamme_etape_delete', {id: etape.id}) }}" onsubmit="return confirm('Êtes-vous sûr de vouloir retirer cette étape ?');" class="mb-0">
                                        <input type="hidden" name="_token" value="{{ csrf_token('delete_etape_' ~ etape.id) }}">
                                        <button class="btn btn-sm btn-outline-danger" type="submit" title="Supprimer l'étape">
                                            <i class="bi bi-trash"></i>
                                        </button>
                                    </form>

                                </div>
                            </td>
                        </tr>
                    {% else %}
                        <tr>
                            <td colspan="5" class="text-center text-muted py-5">
                                <i class="bi bi-list-task fs-1 d-block mb-2 text-secondary opacity-50"></i>
                                Aucune étape définie pour cette gamme.
                            </td>
                        </tr>
                    {% endfor %}
                    </tbody>
                </table>
            </div>
        </div>
    </div>
{% endblock %}
