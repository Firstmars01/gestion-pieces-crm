{% extends './base.html.twig' %}

{% block title %}Gammes de fabrication{% endblock %}

{% block body %}
    <div class="container-fluid py-4">
        {# En-tête avec le même alignement que les autres pages #}
        <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-start gap-3 mb-4">
            <div>
                <h1 class="h3 mb-1">Gammes de fabrication</h1>
                <p class="text-muted mb-0">Supervisez les processus de fabrication, les pièces associées et les responsables.</p>
            </div>

            <div class="d-flex flex-column flex-sm-row gap-2">
                {# Formulaire de recherche #}
                <form method="get" class="mb-0">
                    <div class="input-group">
                        <label>
                            <input type="text" name="q" class="form-control" placeholder="Rechercher..." value="{{ app.request.query.get('q') }}">
                        </label>

                        {% if app.request.query.get('q') %}
                            <a href="{{ path('atelier_gamme_index') }}" class="btn btn-outline-secondary d-flex align-items-center justify-content-center" title="Effacer la recherche">
                                <i class="bi bi-x-lg"></i>
                            </a>
                        {% endif %}

                        <button class="btn btn-primary d-flex align-items-center justify-content-center" type="submit">
                            <i class="bi bi-search"></i>
                        </button>
                    </div>
                </form>

                {# Bouton d'ajout (prêt pour la modale) #}
                <button type="button" onclick="openModalAjax('Nouvelle gamme', '{{ path('atelier_gamme_new') }}')" class="btn btn-primary text-nowrap">
                    <i class="bi bi-plus-circle me-1"></i>
                    Nouvelle gamme
                </button>
            </div>
        </div>

        {# Tableau des gammes #}
        <div class="card shadow-sm border-0 overflow-hidden">
            <div class="table-responsive">
                <table class="table align-middle mb-0 table-sortable">
                    <thead class="table-light">
                    <tr>
                        <th scope="col">{{ knp_pagination_sortable(gammes, 'Gamme', 'g.libelle') }}</th>
                        <th scope="col">{{ knp_pagination_sortable(gammes, 'Pièce fabriquée', 'p.reference') }}</th>
                        <th scope="col">{{ knp_pagination_sortable(gammes, 'Responsable', 'u.nom') }}</th>
                        <th scope="col" class="text-end"></th>
                    </tr>
                    </thead>
                    <tbody>
                    {% for gamme in gammes %}
                        <tr>
                            <td class="fw-semibold">{{ gamme.libelle }}</td>
                            <td>
                                {% if gamme.piece %}
                                    <strong>{{ gamme.piece.reference }}</strong> <span class="text-muted">— {{ gamme.piece.libelle }}</span>
                                {% else %}
                                    <span class="text-muted fst-italic">Aucune pièce liée</span>
                                {% endif %}
                            </td>
                            <td>
                                {% if gamme.user %}
                                    <div class="d-flex align-items-center">
                                        <div class="avatar-initials avatar-initials-primary me-2">
                                            {{ gamme.user.nom|first|upper }}{{ gamme.user.prenom|first|upper }}
                                        </div>

                                        <div class="admin-user-table__identity">
                                            <div class="fw-semibold">{{ gamme.user.nom }} {{ gamme.user.prenom }}</div>
                                        </div>
                                    </div>
                                {% else %}
                                    <span class="text-danger"><i class="bi bi-exclamation-triangle"></i> Sans responsable</span>
                                {% endif %}
                            </td>
                            <td class="text-end">
                                {# Boutons d'actions au survol #}
                                <div class="d-flex justify-content-end gap-2 action-buttons">
                                    <button type="button"
                                            onclick="openModalAjax('Modifier la gamme', '{{ path('atelier_gamme_edit', {id: gamme.id}) }}')"
                                            class="btn btn-sm btn-outline-primary"
                                            title="Modifier">
                                        <i class="bi bi-pencil-square"></i>
                                    </button>

                                    <form method="post" action="{{ path('atelier_gamme_delete', {id: gamme.id}) }}" onsubmit="return confirm('Êtes-vous sûr de vouloir supprimer cette gamme ?');" class="mb-0">
                                        <input type="hidden" name="_token" value="{{ csrf_token('delete_gamme_' ~ gamme.id) }}">
                                        <button class="btn btn-sm btn-outline-danger" type="submit" title="Supprimer">
                                            <i class="bi bi-trash"></i>
                                        </button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    {% else %}
                        <tr>
                            <td colspan="4" class="text-center text-muted py-4">
                                Aucune gamme de fabrication trouvée.
                            </td>
                        </tr>
                    {% endfor %}
                    </tbody>
                </table>
            </div>
        </div>

        {# Pagination Pilule #}
        <div class="pagination-container pagination-pill">
            {{ knp_pagination_render(gammes) }}
        </div>
    </div>
{% endblock %}
