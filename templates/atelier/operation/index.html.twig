{% extends 'base.html.twig' %}

{% block title %}Catalogue des Opérations{% endblock %}

{% block body %}
    <div class="container-fluid py-4">
        <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-start gap-3 mb-4">
            <div>
                <h1 class="h3 mb-1">Catalogue des Opérations</h1>
                <p class="text-muted mb-0">Définissez les tâches standard, leurs temps prévus et les ressources nécessaires.</p>
            </div>

            <div class="d-flex flex-column flex-sm-row gap-2">
                <form method="get" class="mb-0">
                    <div class="input-group">
                        <input type="text" name="q" class="form-control" placeholder="Rechercher..." value="{{ app.request.query.get('q') }}">
                        {% if app.request.query.get('q') %}
                            <a href="{{ path('atelier_operation_index') }}" class="btn btn-outline-secondary d-flex align-items-center justify-content-center" title="Effacer la recherche">
                                <i class="bi bi-x-lg"></i>
                            </a>
                        {% endif %}
                        <button class="btn btn-primary d-flex align-items-center justify-content-center" type="submit">
                            <i class="bi bi-search"></i>
                        </button>
                    </div>
                </form>

                <button type="button" onclick="openModalAjax('Nouvelle opération', '{{ path('atelier_operation_new') }}')" class="btn btn-primary text-nowrap">
                    <i class="bi bi-plus-circle me-1"></i> Ajouter
                </button>
            </div>
        </div>

        <div class="card shadow-sm border-0 overflow-hidden">
            <div class="table-responsive">
                <table class="table align-middle mb-0 table-sortable">
                    <thead class="table-light">
                    <tr>
                        <th scope="col" >{{ knp_pagination_sortable(operations, 'ID', 'o.id') }}</th>
                        <th scope="col">{{ knp_pagination_sortable(operations, 'Opération', 'o.libelle') }}</th>
                        <th scope="col">{{ knp_pagination_sortable(operations, 'Temps prévu', 'o.tempsPrevu') }}</th>
                        <th scope="col">Ressources</th>
                        <th scope="col" class="text-end"></th>
                    </tr>
                    </thead>
                    <tbody>
                    {% for operation in operations %}
                        <tr>
                            <td class="text-muted">#{{ operation.id }}</td>
                            <td class="fw-semibold">{{ operation.libelle }}</td>
                            <td>
                                <span class="bi-stopwatch badge bg-light text-dark border"> {{ operation.tempsPrevu }} min</span>
                            </td>
                            <td>
                                {% if operation.posteMachine %}
                                    <div class="flex-column">
                                        <span class="badge bg-light text-dark border me-1">{{ operation.posteMachine.machine.libelle }}</span>
                                        <span class="badge bg-light text-dark border me-1">{{ operation.posteMachine.poste.libelle }}</span>
                                    </div>
                                {% else %}
                                    <span class="text-danger fst-italic">Non défini</span>
                                {% endif %}
                            </td>
                            <td class="text-end">
                                <div class="d-flex justify-content-end gap-2 action-buttons">
                                    <button type="button"
                                            onclick="openModalAjax('Modifier l\'opération', '{{ path('atelier_operation_edit', {id: operation.id}) }}')"
                                            class="btn btn-sm btn-outline-primary"
                                            title="Modifier">
                                        <i class="bi bi-pencil-square"></i>
                                    </button>

                                    <form method="post" action="{{ path('atelier_operation_delete', {id: operation.id}) }}" onsubmit="return confirm('Êtes-vous sûr de vouloir supprimer cette opération du catalogue ?');" class="mb-0">
                                        <input type="hidden" name="_token" value="{{ csrf_token('delete_operation_' ~ operation.id) }}">
                                        <button class="btn btn-sm btn-outline-danger" type="submit" title="Supprimer">
                                            <i class="bi bi-trash"></i>
                                        </button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    {% else %}
                        <tr>
                            <td colspan="5" class="text-center text-muted py-4">
                                Aucune opération trouvée dans le catalogue.
                            </td>
                        </tr>
                    {% endfor %}
                    </tbody>
                </table>
            </div>
        </div>

        <div class="pagination-container pagination-pill">
            {{ knp_pagination_render(operations) }}
        </div>
    </div>
{% endblock %}
