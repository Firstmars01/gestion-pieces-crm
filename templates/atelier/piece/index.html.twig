{% extends './base.html.twig' %}

{% block title %}Stock des pièces{% endblock %}

{% block body %}
    <div class="container-fluid py-4 atelier-stock-page">
        <div class="atelier-stock-page__header d-flex flex-column flex-md-row justify-content-between align-items-md-start gap-3 mb-4">
            <div>
                <h1 class="h3 atelier-stock-page__title">Stock des pièces</h1>
                <p class="atelier-stock-page__subtitle text-muted">Consultez les références, les quantités disponibles et les composants associés.</p>
            </div>

            <div class="d-flex flex-column flex-sm-row gap-2">
                {# Formulaire de recherche #}
                <form method="get" class="mb-0">
                    <div class="input-group">
                            <input type="text" name="q" class="form-control" placeholder="Rechercher..." value="{{ app.request.query.get('q') }}">

                        {% if app.request.query.get('q') %}
                            <a href="{{ path('atelier_stock') }}" class="btn btn-outline-secondary d-flex align-items-center justify-content-center" title="Effacer la recherche">
                                <i class="bi bi-x-lg"></i>
                            </a>
                        {% endif %}

                        <button class="btn btn-primary d-flex align-items-center justify-content-center" type="submit">
                            <i class="bi bi-search"></i>
                        </button>
                    </div>
                </form>

                <button class="btn btn-primary text-nowrap" onclick="openModalAjax('Ajout d\'une nouvelle pièce', '{{ path('atelier_piece_new') }}')">
                    <i class="bi bi-plus-circle me-1"></i> Nouvelle pièce
                </button>
            </div>
        </div>

        <div class="card shadow-sm border-0 atelier-stock-card overflow-hidden">
            <div class="table-responsive">
                <table class="table align-middle mb-0 table-sortable">
                    <thead class="table-light">
                    <tr>
                        <th scope="col">{{ knp_pagination_sortable(pieces, 'Référence', 'p.reference') }}</th>
                        <th scope="col">{{ knp_pagination_sortable(pieces, 'Libellé', 'p.libelle') }}</th>
                        <th scope="col">{{ knp_pagination_sortable(pieces, 'Type', 'p.type') }}</th>

                        <th scope="col" class="text-end">{{ knp_pagination_sortable(pieces, 'Quantité', 'p.quantiteStock') }}</th>
                        <th scope="col" class="text-end">{{ knp_pagination_sortable(pieces, 'Prix d\'achat', 'p.prixCatalogue') }}</th>
                        <th scope="col" class="text-end">{{ knp_pagination_sortable(pieces, 'Prix vente', 'p.prixVente') }}</th>

                        <th scope="col">Composants</th>
                        <th scope="col" class="text-end"></th>
                    </tr>
                    </thead>
                    <tbody>
                    {% for piece in pieces %}
                        <tr>
                            <td class="fw-semibold">{{ piece.reference }}</td>
                            <td>{{ piece.libelle }}</td>
                            <td>{{ piece.type }}</td>

                            {# Cellule Quantité #}
                            <td class="text-end">
                                <span class="format-number fw-medium" data-value="{{ piece.quantiteStock }}">{{ piece.quantiteStock }}</span>
                            </td>

                            <td class="text-end">
                                {% if piece.prixCatalogue is not null %}
                                    <span class="format-currency" data-value="{{ piece.prixCatalogue }}">{{ piece.prixCatalogue }}</span>
                                {% else %}
                                    <span class="text-muted">-</span>
                                {% endif %}
                            </td>
                            <td class="text-end">
                                {% if piece.prixVente is not null %}
                                    <span class="format-currency" data-value="{{ piece.prixVente }}">{{ piece.prixVente }}</span>
                                {% else %}
                                    <span class="text-muted">-</span>
                                {% endif %}
                            </td>

                            <td class="atelier-stock-components-cell">
                                {% if piece.composants|length == 0 %}
                                    <span class="text-muted">-</span>
                                {% else %}
                                    <ul class="atelier-stock-components mb-0">
                                        {% for comp in piece.composants %}
                                            {% set enfant = comp.pieceEnfant %}
                                            <li>
                                                <span class="format-number" data-value="{{ comp.quantite }}">{{ comp.quantite }}</span> × <strong>{{ enfant.reference }}</strong>
                                                — {{ enfant.libelle }}

                                                {% if enfant.prixVente is not null %}
                                                    (<span class="format-currency text-muted" data-value="{{ enfant.prixVente }}">{{ enfant.prixVente }}</span>)
                                                {% endif %}
                                            </li>
                                        {% endfor %}
                                    </ul>
                                {% endif %}
                            </td>
                            <td class="text-end">
                                <div class="d-flex justify-content-end gap-2 action-buttons">

                                    <button type="button"
                                            onclick="openModalAjax('Modifier', '{{ path('atelier_piece_edit', {id: piece.id}) }}')"
                                            class="btn btn-sm btn-outline-primary"
                                            title="Modifier">
                                        <i class="bi bi-pencil-square"></i>
                                    </button>

                                    <form method="post" action="{{ path('atelier_piece_delete', {id: piece.id}) }}" onsubmit="return confirm('Êtes-vous sûr de vouloir supprimer cet élément ?');">
                                        <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ piece.id) }}">
                                        <button class="btn btn-sm btn-outline-danger" type="submit" title="Supprimer">
                                            <i class="bi bi-trash"></i>
                                        </button>
                                    </form>

                                </div>
                            </td>
                        </tr>
                    {% else %}
                        <tr>
                            <td colspan="8" class="text-center text-muted py-4 atelier-stock-empty-state">
                                <i class="bi bi-box-seam fs-1 d-block mb-2 text-secondary opacity-50"></i>
                                Aucune pièce trouvée.
                            </td>
                        </tr>
                    {% endfor %}
                    </tbody>
                </table>
            </div>
        </div>

        <div class="pagination-container pagination-pill mt-3">
            {{ knp_pagination_render(pieces) }}
        </div>
    </div>
{% endblock %}

{% block javascripts %}
    <script src="{{ asset('js/modal_piece.js') }}"></script>
    <script src="{{ asset('js/format_numbers.js') }}"></script>

{% endblock %}
