{% extends 'base.html.twig' %}

{% block title %}Stock des pièces{% endblock %}

{% block body %}
    <div class="container-fluid py-4 atelier-stock-page">
        <div class="atelier-stock-page__header d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-2">
            <div>
                <h1 class="h3 atelier-stock-page__title">Stock des pièces</h1>
                <p class="atelier-stock-page__subtitle">Consultez les références, les quantités disponibles et les composants associés.</p>
            </div>

            <button class="btn btn-primary" onclick="openModalAjax('Ajout d\'une nouvelle pièce', '{{ path('atelier_piece_new') }}')">
                <i class="bi bi-plus-circle me-1"></i> Nouvelle pièce
            </button>
        </div>

        <div class="card shadow-sm border-0 atelier-stock-card">
            <div class="table-responsive">
                <table class="table align-middle mb-0 atelier-stock-table">
                    <thead class="table-light">
                        <tr>
                            <th scope="col">Référence</th>
                            <th scope="col">Libellé</th>
                            <th scope="col">Type</th>
                            <th scope="col">Quantité en stock</th>
                            <th scope="col">Prix unitaire de vente</th>
                            <th scope="col">Composants (quantité pour 1 unité)</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for piece in pieces %}
                            <tr>
                                <td class="fw-semibold">{{ piece.reference }}</td>
                                <td>{{ piece.libelle }}</td>
                                <td>{{ piece.type }}</td>
                                <td>{{ piece.quantiteStock }}</td>
                                <td>
                                    {% if piece.prixVente is not null %}
                                        {{ piece.prixVente }} €
                                    {% else %}
                                        -
                                    {% endif %}
                                </td>
                                <td class="atelier-stock-components-cell">
                                    {% if piece.composants|length == 0 %}
                                        -
                                    {% else %}
                                        <ul class="atelier-stock-components mb-0">
                                            {% for comp in piece.composants %}
                                                {% set enfant = comp.pieceEnfant %}
                                                <li>
                                                    {{ comp.quantite }} × <strong>{{ enfant.reference }}</strong>
                                                    — {{ enfant.libelle }}
                                                    {% if enfant.prixVente is not null %}
                                                        ({{ enfant.prixVente }} €)
                                                    {% endif %}
                                                </li>
                                            {% endfor %}
                                        </ul>
                                    {% endif %}
                                </td>
                            </tr>
                        {% else %}
                            <tr>
                                <td colspan="6" class="text-center text-muted atelier-stock-empty-state">
                                    Aucune pièce trouvée.
                                </td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        </div>
    </div>
{% endblock %}

