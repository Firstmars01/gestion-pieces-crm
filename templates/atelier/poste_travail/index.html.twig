{% extends 'base.html.twig' %}

{% block title %}Gestion des Postes de Travail{% endblock %}

{% block body %}
    <div class="container-fluid py-4">
        <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-start gap-3 mb-4">
            <div>
                <h1 class="h3 mb-1">Postes de Travail</h1>
                <p class="text-muted mb-0">Gérez les différents espaces de travail de l'atelier de fabrication.</p>
            </div>

            <div class="d-flex flex-column flex-sm-row gap-2">
                <form method="get" class="mb-0">
                    <div class="input-group">
                        <label>
                            <input type="text" name="q" class="form-control" placeholder="Rechercher un poste..." value="{{ app.request.query.get('q') }}">
                        </label>
                        {% if app.request.query.get('q') %}
                            <a href="{{ path('atelier_poste_index') }}" class="btn btn-outline-secondary d-flex align-items-center justify-content-center" title="Effacer la recherche">
                                <i class="bi bi-x-lg"></i>
                            </a>
                        {% endif %}
                        <button class="btn btn-primary d-flex align-items-center justify-content-center" type="submit">
                            <i class="bi bi-search"></i>
                        </button>
                    </div>
                </form>

                <button type="button" onclick="openModalAjax('Nouveau poste', '{{ path('atelier_poste_new') }}')" class="btn btn-primary text-nowrap">
                    <i class="bi bi-plus-circle me-1"></i> Ajouter
                </button>
            </div>
        </div>

        <div class="card shadow-sm border-0 overflow-hidden">
            <div class="table-responsive">
                <table class="table align-middle mb-0 table-sortable">
                    <thead class="table-light">
                    <tr>
                        <th scope="col" style="width: 100px;">{{ knp_pagination_sortable(postes, 'ID', 'p.id') }}</th>
                        <th scope="col">{{ knp_pagination_sortable(postes, 'Libellé du poste', 'p.libelle') }}</th>
                        <th scope="col">Machines affectées</th>
                        <th scope="col">Ouvriers qualifiés</th>
                        <th scope="col" class="text-end"></th>
                    </tr>
                    </thead>
                    <tbody>
                    {% for poste in postes %}
                        <tr>
                            <td class="text-muted">#{{ poste.id }}</td>
                            <td class="fw-semibold">{{ poste.libelle }}</td>
                            <td>
                                {% for pm in poste.posteMachines %}
                                    <span class="badge bg-light text-dark border me-1">{{ pm.machine.libelle }}</span>
                                {% else %}
                                    <span class="text-muted fst-italic fs-7">Aucune machine affectée</span>
                                {% endfor %}
                            </td>
                            <td>
                                {% for qualification in poste.qualifications %}
                                    <span class="badge text-black me-2" title="Qualifié">
                                        <div class="d-flex align-items-center">
                                            <div class="avatar-initials avatar-initials-primary me-2">
                                                {{ qualification.user.nom|first|upper }}{{ qualification.user.prenom|first|upper }}
                                            </div>

                                            <div class="admin-user-table__identity">
                                                <div class="fw-semibold">
                                                    {{ qualification.user.nom }} {{ qualification.user.prenom }}
                                                </div>
                                            </div>
                                        </div>
                                    </span>
                                {% else %}
                                    <span class="text-muted fst-italic fs-7">Aucun ouvrier qualifié</span>
                                {% endfor %}
                            </td>
                            <td class="text-end">
                                <div class="d-flex justify-content-end gap-2 action-buttons">
                                    <button type="button"
                                            onclick="openModalAjax('Modifier le poste', '{{ path('atelier_poste_edit', {id: poste.id}) }}')"
                                            class="btn btn-sm btn-outline-primary"
                                            title="Modifier">
                                        <i class="bi bi-pencil-square"></i>
                                    </button>

                                    <form method="post" action="{{ path('atelier_poste_delete', {id: poste.id}) }}" onsubmit="return confirm('Êtes-vous sûr de vouloir supprimer ce poste de travail ?');" class="mb-0">
                                        <input type="hidden" name="_token" value="{{ csrf_token('delete_poste_' ~ poste.id) }}">
                                        <button class="btn btn-sm btn-outline-danger" type="submit" title="Supprimer">
                                            <i class="bi bi-trash"></i>
                                        </button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    {% else %}
                        <tr>
                            <td colspan="3" class="text-center text-muted py-4">
                                Aucun poste de travail trouvé.
                            </td>
                        </tr>
                    {% endfor %}
                    </tbody>
                </table>
            </div>
        </div>

        <div class="pagination-container pagination-pill">
            {{ knp_pagination_render(postes) }}
        </div>
    </div>
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    <script src="{{ asset('js/modal_poste.js') }}"></script>
{% endblock %}
