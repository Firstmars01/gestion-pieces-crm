{% extends 'base.html.twig' %}

{% block title %}Fabrication #{{ realisation.id }}{% endblock %}

{% block body %}
    {# --- CALCUL DE L'AVANCEMENT --- #}
    {% set total_steps = realisation.realisationPostes|length %}
    {% set done_steps = realisation.realisationPostes|filter(rp => rp.temps is not null)|length %}
    {% set is_finished = (total_steps > 0 and total_steps == done_steps) %}

    <div class="container-fluid py-4">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <div>
                <a href="{{ path('atelier_realisation_index') }}" class="btn btn-sm btn-outline-secondary mb-2">
                    <i class="bi bi-arrow-left"></i> Retour aux fabrications
                </a>
                <h1 class="h3 mb-1">
                    Ordre de Fabrication #{{ realisation.id }}
                </h1>
                <p class="text-muted mb-0">
                    {# On utilise le système d'archive (Snapshot) si la gamme a été supprimée #}
                    Gamme : <strong>{{ realisation.gamme ? realisation.gamme.libelle : realisation.gammeLibelleArchive ~ ' (Archive)' }}</strong> |
                    Pièce à produire : <span class="badge bg-primary">{{ realisation.gamme and realisation.gamme.piece ? realisation.gamme.piece.reference : realisation.pieceReferenceArchive }}</span>
                </p>
            </div>
        </div>

        {# --- LE MESSAGE DE SUCCÈS QUAND TOUT EST FINI --- #}
        {% if is_finished %}
            <div class="alert alert-success d-flex align-items-center mb-4 shadow-sm border-0 border-start border-success border-4 bg-success bg-opacity-10">
                <i class="bi bi-check-circle-fill fs-2 me-3 text-success"></i>
                <div>
                    <h4 class="alert-heading h6 fw-bold mb-1 text-success">Fabrication terminée !</h4>
                    <p class="mb-0 small text-dark">
                        Toutes les étapes ont été validées par l'atelier.
                        <strong>1 unité</strong> de la pièce <strong>{{ realisation.gamme and realisation.gamme.piece ? realisation.gamme.piece.reference : realisation.pieceReferenceArchive }}</strong> a été ajoutée à votre stock.
                    </p>
                </div>
            </div>
        {% endif %}

        <div class="card shadow-sm border-0">
            <div class="card-header bg-light border-bottom d-flex flex-column flex-sm-row justify-content-between align-items-sm-center gap-3 py-3">
                <h5 class="mb-0 fs-6"><i class="bi bi-list-check me-2"></i> Étapes de fabrication</h5>

                <div class="input-group input-group-sm" style="max-width: 300px;">
                    <span class="input-group-text bg-white text-muted"><i class="bi bi-search"></i></span>
                    <input type="text" id="searchStepsInput" class="form-control border-start-0 ps-0" placeholder="Rechercher une étape, opération...">
                </div>
            </div>

            <div class="table-responsive">
                <table class="table align-middle mb-0">
                    <thead class="table-light">
                    <tr>
                        <th style="width: 80px;">Ordre</th>
                        <th>Opération prévue</th>
                        <th>Théorie (Méthodes)</th>
                        <th>Réalité (Atelier)</th>
                        <th class="text-end"></th>
                    </tr>
                    </thead>
                    <tbody id="stepsTableBody">

                    {# LA NOUVELLE BOUCLE : On boucle directement sur les pointages qui ont été copiés au lancement #}
                    {% for pointage in realisation.realisationPostes|sort((a, b) => a.ordre <=> b.ordre) %}

                        {% set estTermine = pointage.temps is not null %}

                        <tr class="{{ estTermine ? 'table-success bg-opacity-10' : '' }}">
                            <td class="fw-bold text-muted">Étape {{ pointage.ordre }}</td>

                            {# Affichage du nom de l'opération (ou de son archive si elle a été supprimée du dico) #}
                            <td class="fw-semibold">
                                {{ pointage.operation ? pointage.operation.libelle : pointage.operationLibelleArchive }}
                            </td>

                            {# Affichage de la THÉORIE (copiée au lancement) #}
                            <td>
                                <div class="text-muted small">
                                    <span class="bi-stopwatch badge bg-light text-dark border"> {{ pointage.tempsPrevu }} min</span>

                                    {% if pointage.operation and pointage.operation.posteMachine %}
                                        <span class="badge bg-light text-dark border"><i class="bi bi-gear"></i> {{ pointage.operation.posteMachine.machine.libelle }}</span>
                                        <span class="badge bg-light text-dark border">{{ pointage.operation.posteMachine.poste.libelle }}</span>
                                    {% endif %}
                                </div>
                            </td>

                            {# Affichage de la RÉALITÉ (saisie par l'ouvrier) #}
                            <td>
                                {% if estTermine %}
                                    <div class="text-success fw-medium small">
                                        <div class="d-flex flex-wrap gap-1 mt-1">
                                            <span class="bi-stopwatch badge bg-light text-dark border"> {{ pointage.temps }} min</span>
                                            <span class="badge bg-light text-dark border"><i class="bi bi-gear"></i> {{ pointage.posteMachine.machine.libelle }}</span>
                                            <span class="badge bg-light text-dark border">{{ pointage.posteMachine.poste.libelle }}</span>
                                        </div>
                                    </div>
                                {% else %}
                                    <span class="badge bg-secondary bg-opacity-10 text-secondary border">En attente</span>
                                {% endif %}
                            </td>

                            <td class="text-end">
                                {% if estTermine %}
                                    <i class="bi bi-check-circle-fill text-success fs-5" title="Opération terminée"></i>
                                {% else %}
                                    {# ATTENTION : L'URL prend maintenant poste_id et non operation_id ! #}
                                    <button type="button"
                                            onclick="openModalAjax('Pointer l\'étape {{ pointage.ordre }}', '{{ path('atelier_realisation_pointer', {id: realisation.id, poste_id: pointage.id}) }}')"
                                            class="btn btn-sm btn-primary text-nowrap shadow-sm">
                                        <i class="bi bi-play-fill me-1"></i> Pointer
                                    </button>
                                {% endif %}
                            </td>
                        </tr>
                    {% else %}
                        <tr>
                            <td colspan="5" class="text-center text-muted py-4">Aucune étape n'a été générée pour cette fabrication.</td>
                        </tr>
                    {% endfor %}
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <script src="{{ asset('js/realisation_filter.js') }}"></script>

{% endblock %}
