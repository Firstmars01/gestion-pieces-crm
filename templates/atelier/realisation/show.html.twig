{% extends 'base.html.twig' %}

{% block title %}Fabrication #{{ realisation.id }}{% endblock %}

{% block body %}
    <div class="container-fluid py-4">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <div>
                <a href="{{ path('atelier_realisation_index') }}" class="btn btn-sm btn-outline-secondary mb-2">
                    <i class="bi bi-arrow-left"></i> Retour aux fabrications
                </a>
                <h1 class="h3 mb-1">
                    Ordre de Fabrication #{{ realisation.id }}
                </h1>
                <p class="text-muted mb-0">
                    Gamme : <strong>{{ realisation.gamme.libelle }}</strong> |
                    Pièce à produire : <span class="badge bg-primary">{{ realisation.gamme.piece.reference }}</span>
                </p>
            </div>
        </div>

        <div class="card shadow-sm border-0">
            <div class="card-header bg-light border-bottom">
                <h5 class="mb-0 fs-6"><i class="bi bi-list-check me-2"></i> Étapes de fabrication</h5>
            </div>
            <div class="table-responsive">
                <table class="table align-middle mb-0">
                    <thead class="table-light">
                    <tr>
                        <th style="width: 80px;">Ordre</th>
                        <th>Opération prévue</th>
                        <th>Théorie (Méthodes)</th>
                        <th>Réalité (Atelier)</th>
                        <th class="text-end"></th>
                    </tr>
                    </thead>
                    <tbody>
                    {# On boucle sur toutes les opérations de la gamme, triées par ordre théorique #}
                    {% for gammeOp in realisation.gamme.gammeOperations|sort((a, b) => a.ordre <=> b.ordre) %}

                        {# On cherche si un pointage réel a déjà été fait pour cette étape #}
                        {% set pointageReel = null %}
                        {% for rp in realisation.realisationPostes %}
                            {% if rp.gammeOperation.id == gammeOp.id %}
                                {% set pointageReel = rp %}
                            {% endif %}
                        {% endfor %}

                        <tr class="{{ pointageReel ? 'table-success bg-opacity-10' : '' }}">
                            <td class="fw-bold text-muted">Étape {{ gammeOp.ordre }}</td>
                            <td class="fw-semibold">{{ gammeOp.operation.libelle }}</td>

                            {# Affichage de la THÉORIE #}
                            <td>
                                <div class="text-muted small">
                                    <span class="bi-stopwatch badge bg-light text-dark border"> {{ gammeOp.operation.tempsPrevu }} min</span>

                                    {% if gammeOp.operation.posteMachine %}
                                        <span class="badge bg-light text-dark border">{{ gammeOp.operation.posteMachine.machine.libelle }}</span>
                                        <span class="badge bg-light text-dark border">{{ gammeOp.operation.posteMachine.poste.libelle }}</span>
                                    {% endif %}
                                </div>
                            </td>

                            {# Affichage de la RÉALITÉ #}
                            <td>
                                {% if pointageReel %}
                                    <div class="text-success fw-medium small">
                                        <div class="d-flex flex-wrap gap-1 mt-1">
                                            <span class="bi-stopwatch badge bg-light text-dark border"> {{ gammeOp.operation.tempsPrevu }} min</span>
                                            <span class="badge bg-light text-dark border">{{ pointageReel.posteMachine.machine.libelle }}</span>
                                            <span class="badge bg-light text-dark border">{{ pointageReel.posteMachine.poste.libelle }}</span>
                                        </div>
                                    </div>
                                {% else %}
                                    <span class="badge bg-secondary bg-opacity-10 text-secondary border">En attente</span>
                                {% endif %}
                            </td>

                            <td class="text-end">
                                {% if pointageReel %}
                                    <i class="bi bi-check-circle-fill text-success fs-5" title="Opération terminée"></i>
                                {% else %}
                                    <button type="button"
                                            onclick="openModalAjax('Pointer l\'étape {{ gammeOp.ordre }}', '{{ path('atelier_realisation_pointer', {id: realisation.id, operation_id: gammeOp.id}) }}')"
                                            class="btn btn-sm btn-primary">
                                        <i class="bi bi-play-fill"></i> Pointer
                                    </button>
                                {% endif %}
                            </td>
                        </tr>
                    {% else %}
                        <tr>
                            <td colspan="5" class="text-center text-muted py-4">Cette gamme ne contient aucune opération.</td>
                        </tr>
                    {% endfor %}
                    </tbody>
                </table>
            </div>
        </div>
    </div>
{% endblock %}
