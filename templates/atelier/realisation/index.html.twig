{% extends 'base.html.twig' %}

{% block title %}Ordres de Fabrication{% endblock %}

{% block body %}
    <div class="container-fluid py-4">
        <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-start gap-3 mb-4">
            <div>
                <h1 class="h3 mb-1">Ordres de Fabrication</h1>
                <p class="text-muted mb-0">Suivez l'avancement des lancements en production de l'atelier.</p>
            </div>

            <div class="d-flex flex-column flex-sm-row gap-2">
                <form method="get" class="mb-0">
                    <div class="input-group">
                        <input type="text" name="q" class="form-control" placeholder="Rechercher..." aria-label="Rechercher" value="{{ app.request.query.get('q') }}">
                        {% if app.request.query.get('q') %}
                            <a href="{{ path('atelier_realisation_index') }}" class="btn btn-outline-secondary d-flex align-items-center justify-content-center" title="Effacer la recherche">
                                <i class="bi bi-x-lg"></i>
                            </a>
                        {% endif %}
                        <button class="btn btn-primary d-flex align-items-center justify-content-center" type="submit">
                            <i class="bi bi-search"></i>
                        </button>
                    </div>
                </form>

                <button type="button" onclick="openModalAjax('Lancer une fabrication', '{{ path('atelier_realisation_new') }}')" class="btn btn-primary text-nowrap">
                    <i class="bi bi-play-circle me-1"></i> Lancer une fabrication
                </button>
            </div>
        </div>

        <div class="card shadow-sm border-0 overflow-hidden">
            <div class="table-responsive">
                <table class="table align-middle mb-0 table-sortable">
                    <thead class="table-light">
                    <tr>
                        <th scope="col" >{{ knp_pagination_sortable(realisations, 'Numéro', 'r.id') }}</th>
                        <th scope="col">{{ knp_pagination_sortable(realisations, 'Gamme associée', 'g.libelle') }}</th>
                        <th scope="col">{{ knp_pagination_sortable(realisations, 'Pièce à produire', 'p.reference') }}</th>
                        <th scope="col" class="min-width-150">Avancement</th>
                        <th scope="col" class="text-end"></th>
                    </tr>
                    </thead>
                    <tbody>
                    {% for realisation in realisations %}

                        {# Le total est le nombre de pointages générés. Terminée = temps n'est pas nul #}
                        {% set total_steps = realisation.realisationPostes|length %}
                        {% set done_steps = realisation.realisationPostes|filter(rp => rp.temps is not null)|length %}
                        {% set progress_percent = total_steps > 0 ? (done_steps / total_steps * 100)|round : 0 %}

                        <tr>
                            <td class="fw-bold text-primary">
                                OF-{{ '%04d'|format(realisation.id) }}
                            </td>

                            <td class="fw-semibold">
                                {{ realisation.gamme ? realisation.gamme.libelle : realisation.gammeLibelleArchive ~ ' (Archive)' }}
                            </td>

                            <td>
                                <span class="badge bg-secondary bg-opacity-10 text-secondary border">
                                    {{ realisation.gamme and realisation.gamme.piece ? realisation.gamme.piece.reference : realisation.pieceReferenceArchive }}
                                </span>
                            </td>

                            <td>
                                <div class="d-flex align-items-center gap-2" title="{{ done_steps }} étape(s) sur {{ total_steps }}">
                                    <div class="progress flex-grow-1 progress-sm" >
                                        <div class="progress-bar {{ progress_percent == 100 ? 'bg-success' : 'bg-primary' }}"
                                             role="progressbar"
                                             style="width: {{ progress_percent }}%"
                                             aria-valuenow="{{ progress_percent }}"
                                             aria-valuemin="0"
                                             aria-valuemax="100"></div>
                                    </div>
                                    <small class="text-muted fw-medium">{{ progress_percent }}%</small>
                                </div>
                            </td>
                            <td class="text-end">
                                <div class="d-flex justify-content-end gap-2 action-buttons">
                                    <a href="{{ path('atelier_realisation_show', {id: realisation.id}) }}"
                                       class="btn btn-sm btn-outline-primary"
                                       title="Ouvrir le tableau de bord">
                                        <i class="bi bi-eye me-1"></i> Consulter
                                    </a>
                                </div>
                            </td>
                        </tr>
                    {% else %}
                        <tr>
                            <td colspan="5" class="text-center text-muted py-4">
                                <i class="bi bi-inbox fs-4 d-block mb-2 text-secondary"></i>
                                Aucun ordre de fabrication en cours. Cliquez sur "Lancer une fabrication" pour commencer.
                            </td>
                        </tr>
                    {% endfor %}
                    </tbody>
                </table>
            </div>
        </div>

        <div class="pagination-container pagination-pill mt-3">
            {{ knp_pagination_render(realisations) }}
        </div>
    </div>
{% endblock %}
