<header class="top-navbar">
    <div class="navbar-left">
        <img src="{{ asset('images/logo.png') }}" alt="Synergy CRM" class="navbar-logo">
    </div>
    <div class="navbar-right">

        <div class="profile-hover-menu">
            <div class="profile-icon">
                <i class="bi bi-person-circle text-dark"></i>
            </div>

            <div class="profile-hover-actions">
                <button type="button" onclick="openModalAjax('Modifier mon mot de passe', '{{ path('app_profile_change_password') }}')" class="profile-action-btn text-primary" title="Modifier le mot de passe">
                    <i class="bi bi-key"></i>
                </button>

                <span class="user-name-drawer">{{ app.user.fullName ?: app.user.email }}</span>

                <a href="{{ path('app_logout') }}" class="profile-action-btn text-danger" title="Se déconnecter">
                    <i class="bi bi-box-arrow-right"></i>
                </a>
            </div>
        </div>

    </div>
</header>

{# On récupère le nom de la route actuelle pour simplifier le code ensuite #}
{% set current_route = app.request.attributes.get('_route') %}

<aside class="sidebar">
    <nav class="sidebar-nav">
        {# Le lien Dashboard est actif si la route actuelle est 'app_home' #}
        <a href="{{ path('app_home') }}" class="sidebar-link {% if current_route == 'app_home' %}active{% endif %}">
            Dashboard
        </a>

        {% if is_granted('ROLE_ADMIN') %}
            <a href="{{ path('admin_user_index') }}" class="sidebar-link {% if current_route starts with 'admin_user_' %}active{% endif %}">
                Administration utilisateur
            </a>
        {% endif %}

        {# Section Atelier : groupe avec sous-menu. Visible pour ROLE_ATELIER et ROLE_ADMIN #}
        {% if is_granted('ROLE_ATELIER') or is_granted('ROLE_ADMIN') %}
            {# Le lien parent ultra propre #}
            <a href="#atelierMenu" class="sidebar-link {% if current_route starts with 'atelier_' %}active{% endif %}"
               data-bs-toggle="collapse" role="button" aria-expanded="{{ (current_route starts with 'atelier_') ? 'true' : 'false' }}" aria-controls="atelierMenu">
                Atelier
                <i class="bi bi-chevron-down"></i>
            </a>

            <div class="collapse {% if current_route starts with 'atelier_' %}show{% endif %} mt-1" id="atelierMenu">
                <nav class="submenu">
                    {# Liste des pages de l'atelier. Ajoute d'autres liens ici si besoin #}
                    <a href="{{ path('atelier_stock') }}" class="sidebar-sublink {% if current_route starts with 'atelier_stock' %}active{% endif %}">
                        Stock des pièces
                    </a>
                    <a href="{{ path('atelier_gamme_index') }}" class="sidebar-sublink {% if current_route starts with 'atelier_gamme_index' %}active{% endif %}">
                        Gammes de fabrication
                    </a>
                    <a href="{{ path('atelier_machine_index') }}" class="sidebar-sublink {% if current_route starts with 'atelier_machine_index' %}active{% endif %}">
                        Machines
                    </a>
                    <a href="{{ path('atelier_poste_index') }}" class="sidebar-sublink {% if current_route starts with 'atelier_poste_index' %}active{% endif %}">
                        Postes de travail
                    </a>
                    <a href="{{ path('atelier_operation_index') }}" class="sidebar-sublink {% if current_route starts with 'atelier_operation_index' %}active{% endif %}">
                        Opérations
                    </a>
                    <a href="{{ path('atelier_qualification_index') }}" class="sidebar-sublink {% if current_route starts with 'atelier_qualification_index' %}active{% endif %}">
                        Qualifications
                    </a>
                    <a href="{{ path('atelier_realisation_index') }}" class="sidebar-sublink {% if current_route starts with 'atelier_realisation_index' %}active{% endif %}">
                        Réalisations
                    </a>
                </nav>
            </div>
        {% endif %}

    </nav>
</aside>
