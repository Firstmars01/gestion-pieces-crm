<header class="top-navbar">
    <div class="navbar-left d-flex align-items-center gap-2">
        {# 1. LE BOUTON HAMBURGER (visible uniquement sur mobile grâce aux classes Bootstrap d-lg-none) #}
        <button type="button" class="mobile-toggle-btn d-lg-none bg-transparent border-0 fs-3 text-dark p-0 d-flex align-items-center" onclick="toggleSidebar()" title="Ouvrir le menu">
            <i class="bi bi-list"></i>
        </button>

        <img src="{{ asset('images/logo.png') }}" alt="Synergy CRM" class="navbar-logo">
    </div>
    <div class="navbar-right">

        {# 2. LE CLIC PROFIL : L'ajout de onclick permet d'ajouter/retirer la classe "active-on-mobile" au toucher #}
        <div class="profile-hover-menu" onclick="this.classList.toggle('active-on-mobile')">
            <div class="profile-icon">
                <i class="bi bi-person-circle text-dark"></i>
            </div>

            <div class="profile-hover-actions">
                <button type="button" onclick="event.stopPropagation(); openModalAjax('Modifier mon mot de passe', '{{ path('app_profile_change_password') }}')" class="profile-action-btn text-primary" title="Modifier le mot de passe">
                    <i class="bi bi-key"></i>
                </button>

                <span class="user-name-drawer">{{ app.user.fullName ?: app.user.email }}</span>

                <a href="{{ path('app_logout') }}" class="profile-action-btn text-danger" title="Se déconnecter">
                    <i class="bi bi-box-arrow-right"></i>
                </a>
            </div>
        </div>

    </div>
</header>

{# On récupère le nom de la route actuelle pour simplifier le code ensuite #}
{% set current_route = app.request.attributes.get('_route') %}

{# Ajout d'un overlay sombre qui apparaîtra derrière la sidebar sur mobile #}
<div id="mobile-sidebar-overlay" class="d-lg-none" onclick="toggleSidebar()"></div>

{# Ajout d'un ID "main-sidebar" pour que le JavaScript puisse la trouver facilement #}
<aside class="sidebar" id="main-sidebar">
    <nav class="sidebar-nav">
        <a href="{{ path('app_home') }}" class="sidebar-link {% if current_route == 'app_home' %}active{% endif %}">
            Dashboard
        </a>

        {% if is_granted('ROLE_ADMIN') %}
            <a href="{{ path('admin_user_index') }}" class="sidebar-link {% if current_route starts with 'admin_user_' %}active{% endif %}">
                Administration utilisateur
            </a>
        {% endif %}

        {% if is_granted('ROLE_ATELIER') or is_granted('ROLE_ADMIN') %}
            <a href="#atelierMenu" class="sidebar-link {% if current_route starts with 'atelier_' %}active{% endif %}"
               data-bs-toggle="collapse" role="button" aria-expanded="{{ (current_route starts with 'atelier_') ? 'true' : 'false' }}" aria-controls="atelierMenu">
                Atelier
                <i class="bi bi-chevron-down"></i>
            </a>

            <div class="collapse {% if current_route starts with 'atelier_' %}show{% endif %} mt-1" id="atelierMenu">
                <nav class="submenu">
                    <a href="{{ path('atelier_stock') }}" class="sidebar-sublink {% if current_route starts with 'atelier_stock' %}active{% endif %}">Stock des pièces</a>

                    {# On a retiré "_index" à la fin de tous les "starts with" pour englober les sous-pages (show, edit, etapes...) #}
                    <a href="{{ path('atelier_gamme_index') }}" class="sidebar-sublink {% if current_route starts with 'atelier_gamme_' %}active{% endif %}">Gammes de fabrication</a>
                    <a href="{{ path('atelier_machine_index') }}" class="sidebar-sublink {% if current_route starts with 'atelier_machine_' %}active{% endif %}">Machines</a>
                    <a href="{{ path('atelier_poste_index') }}" class="sidebar-sublink {% if current_route starts with 'atelier_poste_' %}active{% endif %}">Postes de travail</a>
                    <a href="{{ path('atelier_qualification_index') }}" class="sidebar-sublink {% if current_route starts with 'atelier_qualification_' %}active{% endif %}">Qualifications</a>
                    <a href="{{ path('atelier_operation_index') }}" class="sidebar-sublink {% if current_route starts with 'atelier_operation_' %}active{% endif %}">Opérations</a>
                    <a href="{{ path('atelier_realisation_index') }}" class="sidebar-sublink {% if current_route starts with 'atelier_realisation_' %}active{% endif %}">Réalisations</a>
                </nav>
            </div>
        {% endif %}

        {% if is_granted('ROLE_COMMERCIAL') or is_granted('ROLE_ADMIN') %}
            <a href="#commercialMenu" class="sidebar-link {% if current_route starts with 'commercial_' %}active{% endif %}"
               data-bs-toggle="collapse" role="button" aria-expanded="{{ (current_route starts with 'commercial_') ? 'true' : 'false' }}" aria-controls="commercialMenu">
                Commercial
                <i class="bi bi-chevron-down"></i>
            </a>

            <div class="collapse {% if current_route starts with 'commercial_' %}show{% endif %} mt-1" id="commercialMenu">
                <nav class="submenu">
                    <a href="{{ path('commercial_client_index') }}" class="sidebar-sublink {% if current_route starts with 'commercial_client_' %}active{% endif %}">Clients</a>
                    <a href="{{ path('commercial_devis_index') }}" class="sidebar-sublink {% if current_route starts with 'commercial_devis_' %}active{% endif %}">Devis</a>
                </nav>
            </div>
        {% endif %}

        {% if is_granted('ROLE_ACHATS') or is_granted('ROLE_ADMIN') %}
            <a href="#achatsMenu" class="sidebar-link {% if current_route starts with 'achats_' %}active{% endif %}"
               data-bs-toggle="collapse" role="button" aria-expanded="{{ (current_route starts with 'achats_') ? 'true' : 'false' }}" aria-controls="achatsMenu">
                Achats
                <i class="bi bi-chevron-down"></i>
            </a>

            <div class="collapse {% if current_route starts with 'achats_' %}show{% endif %} mt-1" id="achatsMenu">
                <nav class="submenu">
                    <a href="{{ path('achats_fournisseur_index') }}" class="sidebar-sublink {% if current_route starts with 'achats_fournisseur_' %}active{% endif %}">Fournisseurs</a>
                    <a href="{{ path('achats_commande_index') }}" class="sidebar-sublink {% if current_route starts with 'achats_commande_' %}active{% endif %}">Commandes</a>
                </nav>
            </div>
        {% endif %}

    </nav>
</aside>

{# 3. LE SCRIPT JAVASCRIPT POUR LE MENU MOBILE #}
<script src="{{ asset('js/navbar_mobile.js') }}"></script>


