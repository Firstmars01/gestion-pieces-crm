<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <title>{% block title %}Synergy CRM{% endblock %}</title>
    <meta name="viewport" content="width=device-width, initial-scale=1">

    {# Bootstrap & Icons #}
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

    {# CSS du projet #}
    <link rel="stylesheet" href="{{ asset('styles/app.css') }}">
    <link rel="stylesheet" href="{{ asset('styles/navbar.css') }}">
    <link rel="stylesheet" href="{{ asset('styles/login.css') }}">
    <link rel="stylesheet" href="{{ asset('styles/atelier.css') }}">
    <link rel="stylesheet" href="{{ asset('styles/form.css') }}">

    {% block stylesheets %}{% endblock %}
</head>

<body>

<div class="{{ app.user ? 'app-container' : 'login-wrapper' }}">

    {# Si connecté : On appelle notre fichier de navigation unique #}
    {% if app.user %}
        {% include 'partials/_navigation.html.twig' %}
    {% endif %}

    {# Le contenu principal s'adapte automatiquement #}
    <main class="{{ app.user ? 'main-content' : 'login-content' }}">
        {% block body %}{% endblock %}
    </main>

    {# DÉPLACEMENT : La modale doit être DANS le conteneur principal #}
    <div id="globalOverlay" class="custom-modal-overlay">
        <div class="custom-modal-card">

            <div class="custom-modal-header">
                <h4 id="globalModalTitle" class="m-0 text-dark fw-bold">Titre par défaut</h4>
                <button type="button" class="custom-modal-close" onclick="closeModal()" aria-label="Fermer">
                    <i class="bi bi-x-lg"></i>
                </button>
            </div>

            <div id="globalModalBody" class="custom-modal-body p-4">
                <div class="text-center text-muted my-5">
                    <div class="spinner-border spinner-border-sm" role="status"></div>
                    <span class="ms-2">Chargement...</span>
                </div>
            </div>

        </div>
    </div>
    {# Fin de la modale #}

</div> {# Fin de app-container #}

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

<script src="{{ asset('js/modal.js') }}"></script>

{% block javascripts %}{% endblock %}

</body>
</html>
